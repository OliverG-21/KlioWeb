@inject IJSRuntime JS

<aside class="gallery-sidebar @(_collapsed ? "is-collapsed" : "")" id="gallerySidebar">

    <button class="sidebar-toggle" @onclick="ToggleAsync"
            title="@(_collapsed ? "Navigation aufklappen" : "Navigation einklappen")">
        @(_collapsed ? "›" : "‹")
    </button>

    <a href="/" class="sidebar-brand">
        <span class="nav-icon">&#128247;</span>
        <span class="nav-label">Projekt42</span>
    </a>

    <nav class="sidebar-nav">
        <NavLink href="/" Match="NavLinkMatch.All" class="gallery-nav-link" title="Alle Fotos">
            <span class="nav-icon">&#128444;</span>
            <span class="nav-label">Alle Fotos</span>
        </NavLink>
        <NavLink href="/map" class="gallery-nav-link" title="Karte">
            <span class="nav-icon">&#127757;</span>
            <span class="nav-label">Karte</span>
        </NavLink>
    </nav>

    <div class="sidebar-footer">
        <a href="/admin" class="gallery-nav-link admin-link" title="Administration">
            <span class="nav-icon">&#9881;</span>
            <span class="nav-label">Administration</span>
        </a>
    </div>

</aside>

@code {
    private bool _collapsed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var stored = await JS.InvokeAsync<string?>("localStorage.getItem", "gallerySidebarCollapsed");
                _collapsed = stored == "true";
                StateHasChanged();
            }
            catch { /* pre-render / JS not available */ }
        }
    }

    private async Task ToggleAsync()
    {
        _collapsed = !_collapsed;
        await JS.InvokeVoidAsync("localStorage.setItem", "gallerySidebarCollapsed", _collapsed ? "true" : "false");
    }
}

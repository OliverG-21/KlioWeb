@page "/map"
@inject IImageRepository ImageRepository
@inject IJSRuntime JSRuntime

<PageTitle>Projekt42 - Map</PageTitle>

<h1>Map</h1>

<div id="map"></div>

@if (!hasGpsImages)
{
    <div class="text-muted text-center mt-3">
        <p>No images with GPS coordinates found.</p>
    </div>
}

@code {
    private bool hasGpsImages = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var images = (await ImageRepository.GetWithGpsAsync()).ToList();
        hasGpsImages = images.Any();

        double centerLat = hasGpsImages ? images[0].GpsLatitude!.Value : 48.1351;
        double centerLon = hasGpsImages ? images[0].GpsLongitude!.Value : 11.5820;
        int zoom = hasGpsImages ? 10 : 5;

        await JSRuntime.InvokeVoidAsync("leafletInterop.initMap", "map", centerLat, centerLon, zoom);

        foreach (var image in images)
        {
            var title = image.DateTaken.HasValue
                ? image.DateTaken.Value.ToString("dd.MM.yyyy HH:mm")
                : image.OriginalFilename;

            await JSRuntime.InvokeVoidAsync("leafletInterop.addMarker",
                "map",
                image.GpsLatitude!.Value,
                image.GpsLongitude!.Value,
                title,
                image.ThumbnailPath,
                image.Id);
        }

        if (hasGpsImages && images.Count > 1)
        {
            var markers = images.Select(i => new { lat = i.GpsLatitude!.Value, lon = i.GpsLongitude!.Value }).ToArray();
            await JSRuntime.InvokeVoidAsync("leafletInterop.fitBounds", "map", markers);
        }

        StateHasChanged();
    }
}

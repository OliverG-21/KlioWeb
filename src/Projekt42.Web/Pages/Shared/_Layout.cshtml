@using Microsoft.AspNetCore.Mvc.RazorPages
@using Projekt42.Core.Models
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@inject Projekt42.Core.Interfaces.IAlbumFolderRepository AlbumFolderRepository
@inject Projekt42.Core.Interfaces.ITopicRepository TopicRepository
@{
    // Load flat lists
    var allFolders = (await AlbumFolderRepository.GetAllAsync()).OrderBy(f => f.Name).ToList();
    var allTopics  = (await TopicRepository.GetAllAsync()).OrderBy(t => t.Name).ToList();

    // Build lookup dictionaries (non-nullable keys)
    var subsByParent   = allFolders.Where(f => f.ParentFolderId != null)
                                   .GroupBy(f => f.ParentFolderId!.Value)
                                   .ToDictionary(g => g.Key, g => g.ToList());
    var topicsByFolder = allTopics.Where(t => t.FolderId != null)
                                  .GroupBy(t => t.FolderId!.Value)
                                  .ToDictionary(g => g.Key, g => g.ToList());

    var rootFolders = allFolders.Where(f => f.ParentFolderId == null).ToList();
    var rootTopics  = allTopics.Where(t => t.FolderId == null).ToList();

    // Build tree HTML as string (avoids Razor @ conflicts with Alpine.js directives)
    var sb = new System.Text.StringBuilder();

    void RenderAlbum(Topic album, int depth)
    {
        var indent = (0.9 + depth * 0.75).ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
        var name   = System.Net.WebUtility.HtmlEncode(album.Name);
        sb.Append($"""
            <a href="/topic/{album.Id}" class="gallery-nav-link sidebar-album" style="padding-left:{indent}rem" title="{name}">
                <i class="bi bi-images nav-icon sidebar-album-icon"></i>
                <span class="nav-label">{name}</span>
            </a>
        """);
    }

    void RenderFolder(AlbumFolder folder, int depth)
    {
        var indent  = (0.9 + depth * 0.75).ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
        var id      = folder.Id;
        var name    = System.Net.WebUtility.HtmlEncode(folder.Name);
        var albums  = topicsByFolder.GetValueOrDefault(id, []);
        var subs    = subsByParent.GetValueOrDefault(id, []);
        var hasChildren = albums.Count > 0 || subs.Count > 0;

        sb.Append($"""
            <button class="sidebar-folder-btn" @click="toggle({id})" style="padding-left:{indent}rem" title="{name}">
                <i class="bi nav-icon" :class="open[{id}] ? 'bi-folder2-open' : 'bi-folder2'"></i>
                <i class="bi bi-chevron-right sidebar-chevron" :class="open[{id}] ? 'rotated' : ''" style="{(hasChildren ? "" : "opacity:0;pointer-events:none;")}"></i>
                <span class="nav-label">{name}</span>
            </button>
            <div x-show="open[{id}]" style="display:none">
        """);

        foreach (var album in albums)
            RenderAlbum(album, depth + 1);

        foreach (var sub in subs)
            RenderFolder(sub, depth + 1);

        sb.Append("</div>");
    }

    // Root-level albums (no folder assigned)
    foreach (var t in rootTopics)
        RenderAlbum(t, 0);

    // Root folders with recursive children
    foreach (var f in rootFolders)
        RenderFolder(f, 0);
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Projekt42</title>
    <link rel="stylesheet" href="~/css/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="icon" type="image/png" href="~/favicon.png" />
    <style>
        *, *::before, *::after { box-sizing: border-box; }
        body { margin: 0; padding: 0; min-height: 100vh; display: flex; flex-direction: column; background: #343a40; }

        /* ── Page wrapper ── */
        .page { display: flex; flex: 1; min-height: 100vh; }

        /* ── Main content ── */
        .main-content { flex: 1; background: #f8f9fa; min-width: 0; display: flex; flex-direction: column; }
        .main-article { padding: 1.5rem; flex: 1; }

        /* ── Sidebar ── */
        .gallery-sidebar {
            width: 230px;
            height: 100vh;
            position: sticky;
            top: 0;
            background: transparent;
            display: flex;
            flex-direction: column;
            transition: width 0.25s ease;
            overflow: hidden;
            flex-shrink: 0;
        }
        .gallery-sidebar.collapsed { width: 54px; }

        /* Toggle */
        .sidebar-toggle {
            position: absolute;
            top: 0.7rem;
            right: 0.45rem;
            background: none;
            border: none;
            color: rgba(255, 255, 255, 0.45);
            cursor: pointer;
            padding: 0.2rem 0.35rem;
            border-radius: 4px;
            font-size: 1.1rem;
            line-height: 1;
            z-index: 10;
            transition: color 0.15s;
            flex-shrink: 0;
        }
        .sidebar-toggle:hover { color: #fff; }

        /* Brand */
        .sidebar-brand {
            padding: 1rem 0.9rem;
            padding-right: 2.5rem;
            color: #fff;
            font-weight: 700;
            font-size: 1.2rem;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 0.7rem;
            white-space: nowrap;
            border-bottom: 1px solid rgba(255, 255, 255, 0.15);
            flex-shrink: 0;
        }

        /* Fixed top nav links (Alle Fotos, Karte) */
        .sidebar-nav { flex-shrink: 0; padding-top: 0.4rem; }

        /* Divider */
        .sidebar-divider {
            border: none;
            border-top: 1px solid rgba(255, 255, 255, 0.15);
            margin: 0.3rem 0.9rem;
            flex-shrink: 0;
        }

        /* Scrollable folder tree */
        .sidebar-tree {
            flex: 1;
            min-height: 0;
            overflow-y: auto;
            overflow-x: hidden;
            padding-top: 0.2rem;
        }
        .sidebar-tree::-webkit-scrollbar { width: 4px; }
        .sidebar-tree::-webkit-scrollbar-track { background: transparent; }
        .sidebar-tree::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.2); border-radius: 2px; }

        /* Nav links */
        .gallery-nav-link {
            color: rgba(255, 255, 255, 0.82);
            display: flex;
            align-items: center;
            gap: 0.8rem;
            padding: 0.65rem 0.9rem;
            text-decoration: none;
            white-space: nowrap;
            font-size: 1.05rem;
            transition: color 0.15s, background 0.15s;
            position: relative;
        }
        .gallery-nav-link:hover,
        .gallery-nav-link.active {
            color: #fff;
            background: rgba(255, 255, 255, 0.1);
        }

        /* Album links in tree */
        .sidebar-album { font-size: 0.95rem; }
        .sidebar-album-icon { font-size: 1rem !important; }

        /* Folder toggle buttons */
        .sidebar-folder-btn {
            background: none;
            border: none;
            color: rgba(255, 255, 255, 0.75);
            display: flex;
            align-items: center;
            gap: 0.65rem;
            padding: 0.5rem 0.9rem;
            width: 100%;
            white-space: nowrap;
            font-size: 0.95rem;
            cursor: pointer;
            text-align: left;
            transition: color 0.15s, background 0.15s;
            position: relative;
        }
        .sidebar-folder-btn:hover {
            color: #fff;
            background: rgba(255, 255, 255, 0.08);
        }

        /* Chevron icon */
        .sidebar-chevron {
            font-size: 0.72rem;
            color: rgba(255, 255, 255, 0.35);
            transition: transform 0.2s ease;
            flex-shrink: 0;
            margin-left: auto;
            margin-right: 0.1rem;
        }
        .sidebar-chevron.rotated { transform: rotate(90deg); }

        /* Icons */
        .nav-icon {
            flex-shrink: 0;
            width: 24px;
            text-align: center;
            font-size: 1.15rem;
            color: #fff;
        }
        .sidebar-folder-btn .nav-icon { color: rgba(255, 255, 255, 0.75); }

        /* Labels */
        .nav-label {
            font-size: 1.05rem;
            transition: opacity 0.15s;
            overflow: hidden;
            flex: 1;
        }
        .gallery-sidebar.collapsed .gallery-nav-link .nav-label,
        .gallery-sidebar.collapsed .sidebar-folder-btn .nav-label,
        .gallery-sidebar.collapsed .sidebar-chevron,
        .gallery-sidebar.collapsed .sidebar-brand .nav-label { opacity: 0; width: 0; }

        /* CSS tooltips in collapsed state */
        .gallery-sidebar.collapsed .gallery-nav-link::after,
        .gallery-sidebar.collapsed .sidebar-folder-btn::after {
            content: attr(title);
            position: absolute;
            left: calc(100% + 10px);
            top: 50%;
            transform: translateY(-50%);
            background: rgba(30, 30, 30, 0.9);
            color: #fff;
            padding: 4px 10px;
            border-radius: 5px;
            font-size: 0.88rem;
            white-space: nowrap;
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.15s;
            z-index: 200;
        }
        .gallery-sidebar.collapsed .gallery-nav-link:hover::after,
        .gallery-sidebar.collapsed .sidebar-folder-btn:hover::after { opacity: 1; }

        /* Admin link at bottom */
        .sidebar-footer {
            flex-shrink: 0;
            border-top: 1px solid rgba(255, 255, 255, 0.12);
            padding: 0.4rem 0;
        }
        .admin-link { color: rgba(255, 255, 255, 0.4); font-size: 0.95rem; }
        .admin-link .nav-icon { font-size: 1.05rem; color: rgba(255, 255, 255, 0.4); }
        .admin-link:hover { color: rgba(255, 255, 255, 0.75); background: none; }
        .admin-link:hover .nav-icon { color: rgba(255, 255, 255, 0.75); }

        [x-cloak] { display: none !important; }
    </style>
</head>
<body>
<div class="page">
    <aside class="gallery-sidebar" id="gallerySidebar">

        <button class="sidebar-toggle" id="galleryToggle" title="Navigation einklappen">
            <i class="bi bi-layout-sidebar-reverse"></i>
        </button>

        <a href="/" class="sidebar-brand">
            <i class="bi bi-camera nav-icon"></i>
            <span class="nav-label">Projekt42</span>
        </a>

        <!-- Fixed top nav links -->
        <nav class="sidebar-nav">
            <a href="/" class="gallery-nav-link" title="Alle Fotos">
                <i class="bi bi-images nav-icon"></i>
                <span class="nav-label">Alle Fotos</span>
            </a>
            <a href="/map" class="gallery-nav-link" title="Karte">
                <i class="bi bi-map nav-icon"></i>
                <span class="nav-label">Karte</span>
            </a>
        </nav>

        <!-- Divider -->
        <hr class="sidebar-divider" />

        <!-- Scrollable collapsible folder/album tree -->
        <div class="sidebar-tree"
             x-data="{
                 open: JSON.parse(localStorage.getItem('sidebarFolders') || '{}'),
                 toggle(id) {
                     this.open[id] = !this.open[id];
                     localStorage.setItem('sidebarFolders', JSON.stringify(this.open));
                 }
             }">
            @Html.Raw(sb.ToString())
        </div>

        <!-- Admin link — always at bottom -->
        <div class="sidebar-footer">
            <a href="/admin" class="gallery-nav-link admin-link" title="Administration">
                <i class="bi bi-gear nav-icon"></i>
                <span class="nav-label">Administration</span>
            </a>
        </div>
    </aside>

    <div class="main-content">
        <article class="main-article">
            @RenderBody()
        </article>
    </div>
</div>

<script src="~/js/bootstrap.bundle.min.js"></script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
<script src="~/js/leafletInterop.js"></script>
<script src="~/js/alpine.min.js" defer></script>
<script>
    (function () {
        var STORE = 'gallerySidebarCollapsed';
        function applyState(sidebar, collapsed, animate) {
            if (!animate) sidebar.style.transition = 'none';
            sidebar.classList.toggle('collapsed', collapsed);
            if (!animate) requestAnimationFrame(function () { sidebar.style.transition = ''; });
            var toggle = document.getElementById('galleryToggle');
            if (toggle) {
                toggle.innerHTML = collapsed
                    ? '<i class="bi bi-layout-sidebar"></i>'
                    : '<i class="bi bi-layout-sidebar-reverse"></i>';
                toggle.title = collapsed ? 'Navigation aufklappen' : 'Navigation einklappen';
            }
        }
        document.addEventListener('DOMContentLoaded', function () {
            var sidebar = document.getElementById('gallerySidebar');
            var toggle  = document.getElementById('galleryToggle');
            if (!sidebar || !toggle) return;
            applyState(sidebar, localStorage.getItem(STORE) === 'true', false);
            toggle.addEventListener('click', function () {
                var next = !sidebar.classList.contains('collapsed');
                localStorage.setItem(STORE, next);
                applyState(sidebar, next, true);
            });
        });
    })();
</script>
@RenderSection("Scripts", required: false)
</body>
</html>

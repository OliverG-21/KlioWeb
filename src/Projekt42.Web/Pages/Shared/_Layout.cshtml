@using Microsoft.AspNetCore.Mvc.RazorPages
@using Projekt42.Core.Models
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@inject Projekt42.Core.Interfaces.IAlbumFolderRepository AlbumFolderRepository
@inject Projekt42.Core.Interfaces.ITopicRepository TopicRepository
@inject Projekt42.Core.Interfaces.IImageRepository ImageRepository
@{
    // Load flat lists
    var allFolders   = (await AlbumFolderRepository.GetAllAsync()).OrderBy(f => f.SortOrder).ThenBy(f => f.Name).ToList();
    var allTopics    = (await TopicRepository.GetAllAsync()).OrderBy(t => t.SortOrder).ThenBy(t => t.Name).ToList();
    var imageCounts  = await ImageRepository.GetCountsByTopicAsync();
    var totalImages  = await ImageRepository.GetTotalCountAsync();

    // Build lookup dictionaries (non-nullable keys)
    var subsByParent   = allFolders.Where(f => f.ParentFolderId != null)
                                   .GroupBy(f => f.ParentFolderId!.Value)
                                   .ToDictionary(g => g.Key, g => g.ToList());
    var topicsByFolder = allTopics.Where(t => t.FolderId != null)
                                  .GroupBy(t => t.FolderId!.Value)
                                  .ToDictionary(g => g.Key, g => g.ToList());

    var rootFolders = allFolders.Where(f => f.ParentFolderId == null).ToList();
    var rootTopics  = allTopics.Where(t => t.FolderId == null).ToList();

    // Build tree HTML as string (avoids Razor @ conflicts with Alpine.js directives)
    var sb = new System.Text.StringBuilder();

    void RenderAlbum(Topic album, int depth)
    {
        var indent = (0.9 + depth * 0.75).ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
        var name   = System.Net.WebUtility.HtmlEncode(album.Name);
        var count  = imageCounts.GetValueOrDefault(album.Id, 0);
        var countHtml = count > 0 ? $" <span style=\"color:rgba(255,255,255,0.5);font-size:0.75em;\">({count})</span>" : "";
        sb.Append($"""
            <a href="/album/{album.Id}" class="gallery-nav-link sidebar-album" style="padding-left:{indent}rem" title="{name} ({count} Fotos)">
                <i class="bi bi-images nav-icon sidebar-album-icon"></i>
                <span class="nav-label">{name}{countHtml}</span>
            </a>
        """);
    }

    void RenderFolder(AlbumFolder folder, int depth)
    {
        var indent  = (0.9 + depth * 0.75).ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
        var id      = folder.Id;
        var name    = System.Net.WebUtility.HtmlEncode(folder.Name);
        var albums  = topicsByFolder.GetValueOrDefault(id, []);
        var subs    = subsByParent.GetValueOrDefault(id, []);
        var hasChildren = albums.Count > 0 || subs.Count > 0;

        sb.Append($"""
            <a href="/folder/{id}" class="sidebar-folder-btn" @click="toggle({id})" style="padding-left:{indent}rem" title="{name}">
                <i class="bi nav-icon" :class="open[{id}] ? 'bi-folder2-open' : 'bi-folder2'"></i>
                <i class="bi bi-chevron-right sidebar-chevron" :class="open[{id}] ? 'rotated' : ''" style="{(hasChildren ? "" : "opacity:0;pointer-events:none;")}"></i>
                <span class="nav-label">{name}</span>
            </a>
            <div x-show="open[{id}]" style="display:none">
        """);

        foreach (var album in albums)
            RenderAlbum(album, depth + 1);

        foreach (var sub in subs)
            RenderFolder(sub, depth + 1);

        sb.Append("</div>");
    }

    // Root-level albums (no folder assigned)
    foreach (var t in rootTopics)
        RenderAlbum(t, 0);

    // Root folders with recursive children
    foreach (var f in rootFolders)
        RenderFolder(f, 0);
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Projekt42</title>
    <link rel="stylesheet" href="~/css/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="icon" type="image/png" href="~/favicon.png" />
    <style>
        *, *::before, *::after { box-sizing: border-box; }
        html, body { margin: 0; padding: 0; height: 100vh; overflow: hidden; display: flex; flex-direction: column; background: #343a40; }

        /* ── Page wrapper ── */
        .page { display: flex; flex: 1; height: 100vh; overflow: hidden; }

        /* ── Main content ── */
        .main-content { flex: 1; background: #f8f9fa; min-width: 0; display: flex; flex-direction: column; overflow: hidden; }
        .main-article { padding: 1.5rem; flex: 1; overflow-y: auto; }

        /* ── Sidebar ── */
        .gallery-sidebar {
            width: 230px;
            height: 100vh;
            position: sticky;
            top: 0;
            background: transparent;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            flex-shrink: 0;
        }

        /* Brand */
        .sidebar-brand {
            padding: 1rem 0.9rem;
            padding-right: 2.5rem;
            color: #fff;
            font-weight: 700;
            font-size: 1.2rem;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 0.7rem;
            white-space: nowrap;
            border-bottom: 1px solid rgba(255, 255, 255, 0.15);
            flex-shrink: 0;
        }

        /* Fixed top nav links (Mediathek, Karte) */
        .sidebar-nav { flex-shrink: 0; padding-top: 0.4rem; }

        /* Divider */
        .sidebar-divider {
            border: none;
            border-top: 1px solid rgba(255, 255, 255, 0.15);
            margin: 0.3rem 0.9rem;
            flex-shrink: 0;
        }

        /* Scrollable folder tree */
        .sidebar-tree {
            flex: 1;
            min-height: 0;
            overflow-y: auto;
            overflow-x: hidden;
            padding-top: 0.2rem;
        }
        .sidebar-tree::-webkit-scrollbar { width: 4px; }
        .sidebar-tree::-webkit-scrollbar-track { background: transparent; }
        .sidebar-tree::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.2); border-radius: 2px; }

        /* Nav links */
        .gallery-nav-link {
            color: rgba(255, 255, 255, 0.82);
            display: flex;
            align-items: center;
            gap: 0.8rem;
            padding: 0.65rem 0.9rem;
            text-decoration: none;
            white-space: nowrap;
            font-size: 1.05rem;
            transition: color 0.15s, background 0.15s;
            position: relative;
        }
        .gallery-nav-link:hover,
        .gallery-nav-link.active {
            color: #fff;
            background: rgba(255, 255, 255, 0.1);
        }

        /* Album links in tree */
        .sidebar-album { font-size: 0.95rem; }
        .sidebar-album-icon { font-size: 1rem !important; }

        /* Folder toggle buttons */
        .sidebar-folder-btn {
            background: none;
            border: none;
            text-decoration: none;
            color: rgba(255, 255, 255, 0.75);
            display: flex;
            align-items: center;
            gap: 0.65rem;
            padding: 0.5rem 0.9rem;
            width: 100%;
            white-space: nowrap;
            font-size: 0.95rem;
            cursor: pointer;
            text-align: left;
            transition: color 0.15s, background 0.15s;
            position: relative;
        }
        .sidebar-folder-btn:hover {
            color: #fff;
            background: rgba(255, 255, 255, 0.08);
            text-decoration: none;
        }

        /* Chevron icon */
        .sidebar-chevron {
            font-size: 0.72rem;
            color: rgba(255, 255, 255, 0.35);
            transition: transform 0.2s ease;
            flex-shrink: 0;
            margin-left: auto;
            margin-right: 0.1rem;
        }
        .sidebar-chevron.rotated { transform: rotate(90deg); }

        /* Icons */
        .nav-icon {
            flex-shrink: 0;
            width: 24px;
            text-align: center;
            font-size: 1.15rem;
            color: #fff;
        }
        .sidebar-folder-btn .nav-icon { color: rgba(255, 255, 255, 0.75); }

        /* Labels */
        .nav-label {
            font-size: 1.05rem;
            transition: opacity 0.15s;
            overflow: hidden;
            flex: 1;
        }
        /* Admin link at bottom */
        .sidebar-footer {
            flex-shrink: 0;
            border-top: 1px solid rgba(255, 255, 255, 0.12);
            padding: 0.4rem 0;
        }
        .admin-link { color: rgba(255, 255, 255, 0.4); font-size: 0.95rem; }
        .admin-link .nav-icon { font-size: 1.05rem; color: rgba(255, 255, 255, 0.4); }
        .admin-link:hover { color: rgba(255, 255, 255, 0.75); background: none; }
        .admin-link:hover .nav-icon { color: rgba(255, 255, 255, 0.75); }

        [x-cloak] { display: none !important; }
    </style>
</head>
<body>
<div class="page">
    <aside class="gallery-sidebar">

        <a href="/" class="sidebar-brand">
            <i class="bi bi-camera nav-icon"></i>
            <span class="nav-label">Projekt42</span>
        </a>

        <!-- Fixed top nav links -->
        <nav class="sidebar-nav">
            <a href="/" class="gallery-nav-link" title="Mediathek (@totalImages)">
                <i class="bi bi-images nav-icon"></i>
                <span class="nav-label">Mediathek <span style="color:rgba(255,255,255,0.5);font-size:0.75em;">(@totalImages)</span></span>
            </a>
            <a href="/map" class="gallery-nav-link" title="Karte">
                <i class="bi bi-map nav-icon"></i>
                <span class="nav-label">Karte</span>
            </a>
        </nav>

        <!-- Divider -->
        <hr class="sidebar-divider" />

        <!-- Scrollable collapsible folder/album tree -->
        <div class="sidebar-tree"
             x-data="{
                 open: JSON.parse(localStorage.getItem('sidebarFolders') || '{}'),
                 toggle(id) {
                     this.open[id] = !this.open[id];
                     localStorage.setItem('sidebarFolders', JSON.stringify(this.open));
                 }
             }">
            @Html.Raw(sb.ToString())
        </div>

        <!-- Admin link — always at bottom -->
        <div class="sidebar-footer">
            <a href="/admin" class="gallery-nav-link admin-link" title="Administration">
                <i class="bi bi-gear nav-icon"></i>
                <span class="nav-label">Administration</span>
            </a>
        </div>
    </aside>

    <div class="main-content">
        <article class="main-article">
            @RenderBody()
        </article>
    </div>
</div>

<!-- Shared Lightbox -->
<div id="lightbox">
    <a id="lightbox-back" href="/map" style="display:none" title="Zurück zur Karte">
        <i class="bi bi-map"></i> Zurück zur Karte
    </a>
    <a id="lightbox-map" href="/map" style="display:none" title="Auf Karte anzeigen">
        <i class="bi bi-map"></i> Auf Karte anzeigen
    </a>
    <button id="lightbox-close" title="Schließen">&times;</button>
    <button id="lightbox-prev" onclick="lightboxNavigate(-1)" title="Vorheriges Bild" style="display:none">&#8249;</button>
    <button id="lightbox-next" onclick="lightboxNavigate(1)"  title="Nächstes Bild"  style="display:none">&#8250;</button>
    <div id="lightbox-inner">
        <img id="lightbox-img" src="" alt="" />
        <video id="lightbox-video" style="display:none" controls playsinline>
            <source id="lightbox-video-src" src="" type="">
        </video>
        <div id="lightbox-bar">
            <span id="lb-date"></span>
            <span id="lb-camera"></span>
            <span id="lb-location"></span>
        </div>
    </div>
</div>


<script src="~/js/bootstrap.bundle.min.js"></script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
<script src="~/js/leafletInterop.js"></script>
<script src="~/js/lightbox.js"></script>
<script src="~/js/alpine.min.js" defer></script>
@RenderSection("Scripts", required: false)
</body>
</html>

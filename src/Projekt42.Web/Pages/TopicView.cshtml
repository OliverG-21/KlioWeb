@page "/album/{topicId:int}"
@model TopicViewModel
@{
    ViewData["Title"] = Model.Topic?.Name ?? "Album";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

<div class="mb-3">
    <a href="/" class="text-muted text-decoration-none">
        <i class="bi bi-arrow-left"></i> Mediathek
    </a>
</div>

<h1>@Model.Topic?.Name</h1>
@if (!string.IsNullOrEmpty(Model.Topic?.Description))
{
    <p class="text-muted">@Model.Topic.Description</p>
}

@if (!Model.Images.Any())
{
    <div class="text-center py-5" style="color:#adb5bd;">
        <i class="bi bi-images" style="font-size:3.5rem;display:block;margin-bottom:1rem;"></i>
        <h5 style="color:#6c757d;margin-bottom:0.5rem;">Dieses Album ist noch leer</h5>
        <p style="font-size:0.9rem;">Fotos können über <a href="/admin/upload?topicId=@Model.Topic!.Id" style="color:#1b6ec2;">Hochladen</a> hinzugefügt werden.</p>
    </div>
}
else
{
    <div class="mb-3 d-flex justify-content-between align-items-center">
        <div class="zoom-toolbar">
            <i class="bi bi-image" style="font-size:0.85rem;color:#6c757d;cursor:pointer;" onclick="adjustZoom(-10)"></i>
            <input type="range" id="zoom-slider" min="0" max="100" value="50" oninput="applyZoom(this.value)" ondblclick="resetZoom()">
            <i class="bi bi-image-fill" style="font-size:1.2rem;color:#6c757d;cursor:pointer;" onclick="adjustZoom(10)"></i>
        </div>
        <div class="d-flex gap-2">
        <button id="fit-toggle" onclick="toggleFitMode()"
                style="background:rgba(0,0,0,0.06);border:1px solid rgba(0,0,0,0.15);color:#444;border-radius:20px;padding:0.35rem 1rem;font-size:0.85rem;cursor:pointer;display:inline-flex;align-items:center;gap:0.4rem;transition:background 0.2s,color 0.2s;"
                onmouseover="this.style.background='rgba(0,0,0,0.12)'" onmouseout="this.style.background=_fitMode?'rgba(27,110,194,0.12)':'rgba(0,0,0,0.06)'">
            <i id="fit-icon" class="bi bi-crop" style="font-size:1rem;"></i>
            <span id="fit-label">Quadrat</span>
        </button>
        <button id="sort-toggle" onclick="toggleAlbumSort()"
                style="background:rgba(0,0,0,0.06);border:1px solid rgba(0,0,0,0.15);color:#444;border-radius:20px;padding:0.35rem 1rem;font-size:0.85rem;cursor:pointer;display:inline-flex;align-items:center;gap:0.4rem;transition:background 0.2s,color 0.2s;"
                onmouseover="this.style.background='rgba(0,0,0,0.12)'" onmouseout="this.style.background='rgba(0,0,0,0.06)'">
            <i class="bi bi-sort-down" style="font-size:1rem;"></i> <span id="sort-label">Neueste zuerst</span>
        </button>
        <button onclick="openSlideshow(0)"
                style="background:rgba(0,0,0,0.06);border:1px solid rgba(0,0,0,0.15);color:#444;border-radius:20px;padding:0.35rem 1rem;font-size:0.85rem;cursor:pointer;display:inline-flex;align-items:center;gap:0.4rem;transition:background 0.2s,color 0.2s;"
                onmouseover="this.style.background='rgba(0,0,0,0.12)'" onmouseout="this.style.background='rgba(0,0,0,0.06)'">
            <i class="bi bi-play-circle-fill" style="font-size:1rem;color:#1b6ec2;"></i> Diashow
        </button>
        </div>
    </div>

    <!-- Galerie-Grid -->
    <div class="gallery-grid">
        @{ int slideIdx = 0; }
        @foreach (var image in Model.Images)
        {
            var imgDate   = (image.DateTaken ?? image.CreatedAt).ToString("dd.MM.yyyy");
            var imgTs     = (image.DateTaken ?? image.CreatedAt).ToString("yyyyMMddHHmmss");
            var imgCamera = image.CameraModel ?? "";
            var imgLat    = image.GpsLatitude?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "";
            var imgLon    = image.GpsLongitude?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "";
            var imgMime   = image.MimeType;
            var isVideoVal = image.IsVideo ? "1" : "";
            <div class="gallery-item"
                 data-id="@image.Id"
                 data-date="@imgDate"
                 data-ts="@imgTs"
                 data-camera="@imgCamera"
                 data-lat="@imgLat"
                 data-lon="@imgLon"
                 data-slideidx="@slideIdx"
                 data-is-video="@isVideoVal"
                 data-mime-type="@imgMime"
                 onclick="window.openLightbox(this.dataset.id, this.dataset.date, this.dataset.camera, this.dataset.lat||null, this.dataset.lon||null, this.dataset.isVideo==='1', this.dataset.mimeType||'')"
                 style="cursor:pointer">
                @if (!string.IsNullOrEmpty(image.ThumbnailPath))
                {
                    <img src="/images/thumbnail/@image.Id" alt="@image.OriginalFilename" loading="lazy" />
                }
                else
                {
                    <div class="gallery-placeholder">
                        <span style="color:#6c757d;">No preview</span>
                    </div>
                }
                @if (image.IsVideo)
                {
                    <div class="video-play-overlay">&#9654;</div>
                }
                <div class="gallery-item-info">
                    <div class="info-date">@imgDate</div>
                </div>
            </div>
            slideIdx++;
        }
    </div>

    <!-- Diashow-Overlay -->
    <div id="slideshow-overlay" style="display:none;position:fixed;inset:0;z-index:10000;background:#000;">

        <!-- Bild-Bereich (füllt alles bis auf die Steuerleiste) -->
        <div style="position:absolute;inset:0 0 72px 0;">
            <div class="swiper slideshow-swiper" style="width:100%;height:100%;">
                <div class="swiper-wrapper">
                    @foreach (var image in Model.Images)
                    {
                        <div class="swiper-slide" style="display:flex;align-items:center;justify-content:center;">
                            <img src="/images/serve/@image.Id"
                                 alt="@image.OriginalFilename"
                                 style="max-width:100%;max-height:100%;object-fit:contain;display:block;" />
                        </div>
                    }
                </div>
                <div class="slideshow-caption" id="slideshow-caption"></div>
            </div>
        </div>

        <!-- Schließen-Button oben rechts -->
        <button onclick="slideshowStop()" title="Schließen"
                style="position:absolute;top:1rem;right:1rem;z-index:10;background:rgba(255,255,255,0.12);border:none;color:rgba(255,255,255,0.8);border-radius:50%;width:2.5rem;height:2.5rem;display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:1rem;transition:background 0.2s,transform 0.15s;">
            <i class="bi bi-x-lg"></i>
        </button>

        <!-- Steuerleiste (72px hoch, unten fixiert) -->
        <div style="position:absolute;bottom:0;left:0;right:0;height:72px;background:linear-gradient(to top,rgba(0,0,0,0.9),rgba(0,0,0,0.6));display:flex;align-items:center;justify-content:center;gap:0.75rem;padding:0 2rem;">

            <span id="slideshow-counter" style="color:rgba(255,255,255,0.5);font-size:0.82rem;min-width:3.5rem;text-align:right;"></span>

            <button onclick="slideshowPrev()" title="Zurück" style="background:rgba(255,255,255,0.1);border:none;color:rgba(255,255,255,0.75);border-radius:50%;width:2.5rem;height:2.5rem;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;font-size:1rem;transition:background 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.2)'" onmouseout="this.style.background='rgba(255,255,255,0.1)'"><i class="bi bi-skip-start-fill"></i></button>
            <button id="slideshow-play-btn" onclick="slideshowTogglePlay()" title="Play/Pause" style="background:#fff;border:none;color:#111;border-radius:50%;width:3rem;height:3rem;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;font-size:1.2rem;transition:background 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.85)'" onmouseout="this.style.background='#fff'"><i class="bi bi-pause-fill"></i></button>
            <button onclick="slideshowStop()" title="Stopp" style="background:rgba(255,255,255,0.1);border:none;color:rgba(255,255,255,0.75);border-radius:50%;width:2.5rem;height:2.5rem;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;font-size:1rem;transition:background 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.2)'" onmouseout="this.style.background='rgba(255,255,255,0.1)'"><i class="bi bi-stop-fill"></i></button>
            <button onclick="slideshowNext()" title="Weiter" style="background:rgba(255,255,255,0.1);border:none;color:rgba(255,255,255,0.75);border-radius:50%;width:2.5rem;height:2.5rem;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;font-size:1rem;transition:background 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.2)'" onmouseout="this.style.background='rgba(255,255,255,0.1)'"><i class="bi bi-skip-end-fill"></i></button>

            <div style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.45);font-size:0.8rem;margin-left:0.5rem;">
                <label style="margin:0;">Dauer</label>
                <input id="slideshow-duration" type="number" value="5" min="1" max="60" step="1"
                       onchange="slideshowUpdateDuration(this.value)" onclick="event.stopPropagation()"
                       style="width:3rem;background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.2);color:#fff;padding:0.2rem 0.4rem;border-radius:6px;font-size:0.8rem;text-align:center;outline:none;" />
                <span>s</span>
            </div>
        </div>
    </div>

    <!-- ── Enhanced Slideshow Overlay ──────────────────────────────────── -->
    <div id="enh-overlay">
        <div id="enh-layer-a"></div>
        <div id="enh-layer-b" style="opacity:0;"></div>

        <button onclick="enhStop()" title="Schließen"
                style="position:absolute;top:1rem;right:1rem;z-index:20;background:rgba(255,255,255,0.12);border:none;color:rgba(255,255,255,0.85);border-radius:50%;width:2.5rem;height:2.5rem;display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:1rem;transition:background 0.2s;">
            <i class="bi bi-x-lg"></i>
        </button>

        <div style="position:absolute;bottom:0;left:0;right:0;height:64px;background:linear-gradient(to top,rgba(0,0,0,0.85),rgba(0,0,0,0.5));display:flex;align-items:center;justify-content:center;gap:0.75rem;z-index:20;">
            <span id="enh-counter" style="color:rgba(255,255,255,0.45);font-size:0.82rem;min-width:3.5rem;text-align:right;"></span>
            <button onclick="enhTogglePlay()" id="enh-play-btn" title="Play/Pause"
                    style="background:#fff;border:none;color:#111;border-radius:50%;width:3rem;height:3rem;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;font-size:1.2rem;">
                <i class="bi bi-pause-fill"></i>
            </button>
            <button onclick="enhStop()" title="Stopp"
                    style="background:rgba(255,255,255,0.1);border:none;color:rgba(255,255,255,0.75);border-radius:50%;width:2.5rem;height:2.5rem;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;font-size:1rem;">
                <i class="bi bi-stop-fill"></i>
            </button>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script>
    (function () {
        var swiper = null;
        var playing = true;
        var total = @Model.Images.Count();

        function updateCounter() {
            if (!swiper) return;
            document.getElementById('slideshow-counter').textContent = (swiper.activeIndex + 1) + ' / ' + total;
            var slides = document.querySelectorAll('.slideshow-swiper .swiper-slide');
            var slide = slides[swiper.activeIndex];
            var img = slide ? slide.querySelector('img') : null;
            document.getElementById('slideshow-caption').textContent = img ? img.alt : '';
        }

        function setPlayBtn(isPlaying) {
            playing = isPlaying;
            document.getElementById('slideshow-play-btn').innerHTML = isPlaying
                ? '<i class="bi bi-pause-fill"></i>'
                : '<i class="bi bi-play-fill"></i>';
        }

        window.openSlideshow = function (startIndex) {
            var mode = localStorage.getItem('slideshowMode') || 'classic';
            if (mode === 'enhanced') { enhStart(); return; }

            var overlay = document.getElementById('slideshow-overlay');
            overlay.style.display = 'block';
            var delay = (parseInt(document.getElementById('slideshow-duration').value) || 5) * 1000;
            requestAnimationFrame(function () {
                if (!swiper) {
                    swiper = new Swiper('.slideshow-swiper', {
                        effect: 'fade',
                        fadeEffect: { crossFade: true },
                        initialSlide: startIndex || 0,
                        speed: 800,
                        autoplay: { delay: delay, disableOnInteraction: false },
                        on: {
                            slideChange: updateCounter,
                            autoplayStart: function () { setPlayBtn(true); },
                            autoplayStop: function () { setPlayBtn(false); }
                        }
                    });
                } else {
                    swiper.slideTo(startIndex || 0, 0);
                    swiper.autoplay.start();
                }
                updateCounter();
                setPlayBtn(true);
            });
        };

        window.slideshowStop = function () {
            if (swiper) swiper.autoplay.stop();
            document.getElementById('slideshow-overlay').style.display = 'none';
        };

        window.slideshowTogglePlay = function () {
            if (!swiper) return;
            playing ? swiper.autoplay.stop() : swiper.autoplay.start();
        };

        window.slideshowPrev = function () { if (swiper) swiper.slidePrev(); };
        window.slideshowNext = function () { if (swiper) swiper.slideNext(); };

        window.slideshowUpdateDuration = function (val) {
            var ms = Math.max(parseInt(val) || 5, 1) * 1000;
            if (swiper) {
                swiper.params.autoplay.delay = ms;
                if (playing) { swiper.autoplay.stop(); swiper.autoplay.start(); }
            }
        };

        document.addEventListener('keydown', function (e) {
            if (document.getElementById('slideshow-overlay').style.display === 'none') return;
            if (e.key === 'Escape') slideshowStop();
            else if (e.key === ' ') { e.preventDefault(); slideshowTogglePlay(); }
            else if (e.key === 'ArrowLeft') slideshowPrev();
            else if (e.key === 'ArrowRight') slideshowNext();
        });
    })();

    </script>
}

@section Scripts {
<script>
    function applyZoom(value) {
        var size = Math.round(200 * Math.pow(2, (value - 50) / 50));
        document.documentElement.style.setProperty('--gallery-thumb-size', size + 'px');
    }
    function adjustZoom(delta) {
        var s = document.getElementById('zoom-slider');
        s.value = Math.max(0, Math.min(100, +s.value + delta));
        applyZoom(s.value);
    }
    function resetZoom() {
        var s = document.getElementById('zoom-slider');
        s.value = 50;
        applyZoom(50);
    }

    var initialSel = @Html.Raw(Model.InitialSelJson);
    if (initialSel) {
        window.openLightbox(initialSel.id, initialSel.date, initialSel.camera, initialSel.lat, initialSel.lon);
    }

    // ── Enhanced Slideshow ───────────────────────────────────────────────────
    (function () {
        var ENH_SCENE_DUR  = 7500;   // ms per scene
        var ENH_TRANS_DUR  = 1400;   // ms crossfade
        var KB_DUR         = (ENH_SCENE_DUR + ENH_TRANS_DUR) / 1000 + 's';

        var albumName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Topic?.Name ?? ""));
        var allImages = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.Images.Select(i => new { id = i.Id, filename = i.OriginalFilename }).ToList()
        ));

        var layerA   = document.getElementById('enh-layer-a');
        var layerB   = document.getElementById('enh-layer-b');
        var overlay  = document.getElementById('enh-overlay');
        var counter  = document.getElementById('enh-counter');
        var playBtn  = document.getElementById('enh-play-btn');

        var scenes      = [];
        var sceneIdx    = 0;
        var layerFlip   = false;   // false = A front, B back
        var timer       = null;
        var enhPlaying  = false;
        var initialized = false;

        var KB = ['kb1','kb2','kb3','kb4','kb5'];

        function shuffle(arr) {
            var a = arr.slice();
            for (var i = a.length - 1; i > 0; i--) {
                var j = Math.floor(Math.random() * (i + 1));
                var t = a[i]; a[i] = a[j]; a[j] = t;
            }
            return a;
        }

        function buildScenes(images) {
            var out = [];
            var s   = shuffle(images);
            if (s.length === 0) return out;
            out.push({ type: 'title', imgs: [s[0]] });
            var i = 1, kb = 0;
            while (i < s.length) {
                var rem = s.length - i;
                var r   = Math.random();
                var type, n;
                if      (rem >= 3 && r < 0.25) { type = 'three';  n = 3; }
                else if (rem >= 2 && r < 0.55) { type = 'two';    n = 2; }
                else if (rem >= 1 && r < 0.70) { type = 'focus';  n = 1; }
                else                            { type = 'one';    n = 1; }
                out.push({ type: type, imgs: s.slice(i, i + n), kb: kb });
                kb = (kb + n) % 5;
                i += n;
            }
            return out;
        }

        function imgTag(id, kbClass) {
            return '<img src="/images/serve/' + id + '" loading="eager"'
                + (kbClass ? ' class="' + kbClass + '" style="--kb-dur:' + KB_DUR + '"' : '')
                + ' />';
        }

        function wrap(cls, content) {
            return '<div class="enh-img-wrap ' + cls + '">' + content + '</div>';
        }

        function renderScene(scene, el) {
            var kb = scene.kb || 0;
            var html = '';
            if (scene.type === 'one') {
                html = wrap('enh-full', imgTag(scene.imgs[0].id, KB[kb % 5]));
            } else if (scene.type === 'two') {
                html = wrap('enh-left',  imgTag(scene.imgs[0].id, KB[kb % 5]))
                     + wrap('enh-right', imgTag(scene.imgs[1].id, KB[(kb+1) % 5]));
            } else if (scene.type === 'three') {
                html = wrap('enh-main', imgTag(scene.imgs[0].id, KB[kb % 5]))
                     + wrap('enh-top',  imgTag(scene.imgs[1].id, KB[(kb+1) % 5]))
                     + wrap('enh-bot',  imgTag(scene.imgs[2].id, KB[(kb+2) % 5]));
            } else if (scene.type === 'focus') {
                html = wrap('enh-full enh-blur-bg', imgTag(scene.imgs[0].id, ''))
                     + wrap('enh-center', imgTag(scene.imgs[0].id, KB[kb % 5]));
            } else if (scene.type === 'title') {
                html = wrap('enh-full', imgTag(scene.imgs[0].id, 'kb1" style="--kb-dur:' + KB_DUR))
                     + '<div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.38);">'
                     + '<div style="text-align:center;color:#fff;padding:2rem;">'
                     + '<div style="font-size:clamp(1.4rem,4vw,3rem);font-weight:300;letter-spacing:0.12em;text-shadow:0 2px 12px rgba(0,0,0,0.6);">'
                     + albumName + '</div></div></div>';
            }
            el.innerHTML = html;
        }

        function showScene(idx) {
            var front = layerFlip ? layerB : layerA;
            var back  = layerFlip ? layerA : layerB;

            renderScene(scenes[idx], back);

            back.style.transition  = 'none';
            back.style.opacity     = '0';
            back.style.display     = 'block';
            back.offsetHeight; // force reflow

            back.style.transition  = 'opacity ' + (ENH_TRANS_DUR / 1000) + 's ease-in-out';
            back.style.opacity     = '1';
            front.style.transition = 'opacity ' + (ENH_TRANS_DUR / 1000) + 's ease-in-out';
            front.style.opacity    = '0';

            layerFlip = !layerFlip;
            if (counter) counter.textContent = (idx + 1) + ' / ' + scenes.length;
        }

        function advanceScene() {
            sceneIdx = (sceneIdx + 1) % scenes.length;
            showScene(sceneIdx);
        }

        function scheduleNext() {
            timer = setTimeout(function () {
                if (enhPlaying) { advanceScene(); scheduleNext(); }
            }, ENH_SCENE_DUR);
        }

        window.enhStart = function () {
            if (!initialized) {
                scenes      = buildScenes(allImages);
                initialized = true;
            }
            sceneIdx   = 0;
            layerFlip  = false;
            enhPlaying = true;

            layerA.style.opacity = '0';
            layerB.style.opacity = '0';
            overlay.style.display = 'block';

            showScene(0);
            scheduleNext();
            if (playBtn) playBtn.innerHTML = '<i class="bi bi-pause-fill"></i>';
        };

        window.enhStop = function () {
            enhPlaying = false;
            clearTimeout(timer);
            overlay.style.display = 'none';
            layerA.innerHTML = '';
            layerB.innerHTML = '';
            initialized = false;
        };

        window.enhTogglePlay = function () {
            if (enhPlaying) {
                enhPlaying = false;
                clearTimeout(timer);
                if (playBtn) playBtn.innerHTML = '<i class="bi bi-play-fill"></i>';
            } else {
                enhPlaying = true;
                scheduleNext();
                if (playBtn) playBtn.innerHTML = '<i class="bi bi-pause-fill"></i>';
            }
        };

        document.addEventListener('keydown', function (e) {
            if (overlay.style.display === 'none') return;
            if (e.key === 'Escape') enhStop();
            if (e.key === ' ') { e.preventDefault(); enhTogglePlay(); }
        });
    })();
    // ─────────────────────────────────────────────────────────────────────────

    var _fitMode = localStorage.getItem('galleryFitMode') === '1';
    function applyFitMode() {
        var grid = document.querySelector('.gallery-grid');
        if (grid) grid.classList.toggle('gallery-grid--fit', _fitMode);
        var icon = document.getElementById('fit-icon');
        var label = document.getElementById('fit-label');
        var btn = document.getElementById('fit-toggle');
        if (_fitMode) {
            if (icon) icon.className = 'bi bi-aspect-ratio';
            if (label) label.textContent = 'Original';
            if (btn) btn.style.background = 'rgba(27,110,194,0.12)';
            if (btn) btn.style.color = '#1b6ec2';
            if (btn) btn.style.borderColor = 'rgba(27,110,194,0.4)';
        } else {
            if (icon) icon.className = 'bi bi-crop';
            if (label) label.textContent = 'Quadrat';
            if (btn) btn.style.background = 'rgba(0,0,0,0.06)';
            if (btn) btn.style.color = '#444';
            if (btn) btn.style.borderColor = 'rgba(0,0,0,0.15)';
        }
    }
    function toggleFitMode() {
        _fitMode = !_fitMode;
        localStorage.setItem('galleryFitMode', _fitMode ? '1' : '0');
        applyFitMode();
    }
    applyFitMode();

    var _sortAsc = false; // initial: newest first (desc)
    function toggleAlbumSort() {
        _sortAsc = !_sortAsc;
        var grid = document.querySelector('.gallery-grid');
        var items = Array.from(grid.querySelectorAll('.gallery-item'));
        items.sort(function (a, b) {
            var ta = a.dataset.ts || '';
            var tb = b.dataset.ts || '';
            return _sortAsc ? ta.localeCompare(tb) : tb.localeCompare(ta);
        });
        var frag = document.createDocumentFragment();
        items.forEach(function (el) { frag.appendChild(el); });
        grid.appendChild(frag);
        document.getElementById('sort-label').textContent = _sortAsc ? 'Älteste zuerst' : 'Neueste zuerst';
        var icon = document.querySelector('#sort-toggle .bi');
        icon.className = _sortAsc ? 'bi bi-sort-up' : 'bi bi-sort-down';
    }
</script>

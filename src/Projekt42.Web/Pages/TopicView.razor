@page "/topic/{TopicId:int}"
@inject IImageRepository ImageRepository
@inject ITopicRepository TopicRepository

<PageTitle>Projekt42 - Topic</PageTitle>

@if (topic != null)
{
    <h1>@topic.Name</h1>
    @if (!string.IsNullOrEmpty(topic.Description))
    {
        <p class="text-muted">@topic.Description</p>
    }
}

@if (loading)
{
    <p>Loading...</p>
}
else if (!images.Any())
{
    <div class="text-muted text-center py-5">
        <p>No images in this topic yet.</p>
    </div>
}
else
{
    <div class="gallery-grid">
        @foreach (var image in images)
        {
            <div class="gallery-item" @onclick="() => SelectImage(image)">
                @if (!string.IsNullOrEmpty(image.ThumbnailPath))
                {
                    <img src="/images/thumbnail/@image.Id" alt="@image.OriginalFilename" loading="lazy" />
                }
                else
                {
                    <div style="width:100%;height:200px;background:#e9ecef;display:flex;align-items:center;justify-content:center;">
                        <span style="color:#6c757d;">No preview</span>
                    </div>
                }
                <div class="gallery-item-info">
                    @if (image.DateTaken.HasValue)
                    {
                        <div>@image.DateTaken.Value.ToString("dd.MM.yyyy")</div>
                    }
                </div>
            </div>
        }
    </div>
}

@if (selectedImage != null)
{
    <div class="modal show d-block" style="background:rgba(0,0,0,0.8);" @onclick="CloseModal">
        <div class="modal-dialog modal-lg modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@selectedImage.OriginalFilename</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body text-center">
                    <img src="/images/serve/@selectedImage.Id" class="img-fluid" alt="@selectedImage.OriginalFilename" />
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseModal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int TopicId { get; set; }

    private Topic? topic;
    private List<Projekt42.Core.Models.Image> images = new();
    private Projekt42.Core.Models.Image? selectedImage;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        topic = await TopicRepository.GetByIdAsync(TopicId);
        images = (await ImageRepository.GetByTopicIdAsync(TopicId)).ToList();
        loading = false;
    }

    private void SelectImage(Projekt42.Core.Models.Image image) => selectedImage = image;
    private void CloseModal() => selectedImage = null;
}

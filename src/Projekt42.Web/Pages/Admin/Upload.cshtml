@page "/admin/upload"
@model Projekt42.Web.Pages.Admin.UploadModel
@{
    Layout = "_AdminLayout";
}

<h1 class="mb-4">Upload</h1>

@if (Model.SuccessMessage != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm" style="max-width:640px;">
    <div class="card-body">
        <h5 class="card-title mb-3">Bilder hochladen</h5>
        <p class="text-muted" style="font-size:0.9rem;">
            Unterst&uuml;tzte Formate: JPEG, PNG, HEIC.
            Die Dateien werden in den Eingangsordner gespeichert und automatisch verarbeitet.
        </p>
        <form method="post" enctype="multipart/form-data" asp-antiforgery="true">
            <div class="mb-3">
                <label for="files" class="form-label">Dateien ausw&auml;hlen</label>
                <input type="file" id="files" name="files" class="form-control"
                       multiple accept="image/jpeg,image/png,image/heic,.heic,.jpg,.jpeg,.png"
                       required />
                <div class="form-text">Mehrere Dateien k&ouml;nnen gleichzeitig ausgew&auml;hlt werden.</div>
            </div>
            <button type="submit" class="btn btn-primary">
                Hochladen
            </button>
        </form>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.InboxPath))
{
    <div class="mt-3">
        <small class="text-muted">Eingangsordner: <code>@Model.InboxPath</code></small>
    </div>
}

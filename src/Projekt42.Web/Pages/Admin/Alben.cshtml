@page "/admin/alben"
@model Projekt42.Web.Pages.Admin.AlbenModel
@{
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Alben</h1>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#albumModal"
            onclick="openCreateModal()">
        + Neues Album
    </button>
</div>

@if (Model.SuccessMessage != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Topics.Any())
{
    <div class="text-center py-5 text-muted">
        <p class="fs-1">&#128193;</p>
        <p class="mt-2">Noch keine Alben vorhanden.</p>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#albumModal"
                onclick="openCreateModal()">
            Erstes Album erstellen
        </button>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var item in Model.Topics)
        {
            var count = Model.ImageCounts.GetValueOrDefault(item.Id, 0);
            var coverId = Model.CoverImageIds.GetValueOrDefault(item.Id, 0);
            <div class="col-sm-6 col-md-4 col-lg-3">
                <div class="card h-100 shadow-sm">
                    <a href="/topic/@item.Id" style="text-decoration:none;color:inherit;">
                        @if (coverId > 0)
                        {
                            <img src="/images/thumbnail/@coverId" class="card-img-top" alt="@item.Name"
                                 style="height:160px;object-fit:cover;" />
                        }
                        else
                        {
                            <div class="card-img-top d-flex align-items-center justify-content-center bg-light"
                                 style="height:160px;font-size:2.5rem;color:#adb5bd;">
                                &#128247;
                            </div>
                        }
                    </a>
                    <div class="card-body pb-1">
                        <h6 class="card-title mb-1">
                            <a href="/topic/@item.Id" style="text-decoration:none;color:inherit;">@item.Name</a>
                        </h6>
                        @if (!string.IsNullOrEmpty(item.Description))
                        {
                            <p class="card-text text-muted" style="font-size:0.8rem;">
                                @(item.Description.Length > 80 ? item.Description[..80] + "\u2026" : item.Description)
                            </p>
                        }
                    </div>
                    <div class="card-footer d-flex justify-content-between align-items-center bg-transparent border-top-0 pt-0">
                        <small class="text-muted">@count Foto@(count != 1 ? "s" : "")</small>
                        <div class="d-flex gap-1">
                            <button type="button" class="btn btn-sm btn-outline-primary"
                                    onclick="openEditModal(@item.Id, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(item.Name)), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(item.Description)))">
                                Bearbeiten
                            </button>
                            <form method="post" asp-page-handler="Delete" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                        @(count > 0 ? "disabled" : "")
                                        onclick="return confirm('Album \'@item.Name\' wirklich l\u00f6schen?');">
                                    L&ouml;schen
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- Album Modal -->
<div class="modal fade" id="albumModal" tabindex="-1" aria-labelledby="albumModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="albumModalLabel">Neues Album</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="albumForm" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" id="modalId" name="id" value="0" />
                    <div class="mb-3">
                        <label for="modalName" class="form-label">Name <span class="text-danger">*</span></label>
                        <input type="text" id="modalName" name="name" class="form-control"
                               placeholder="z.B. Urlaub Italien 2024" required />
                    </div>
                    <div class="mb-3">
                        <label for="modalDescription" class="form-label">
                            Beschreibung <span class="text-muted">(optional)</span>
                        </label>
                        <textarea id="modalDescription" name="description" class="form-control"
                                  rows="3" placeholder="Kurze Beschreibung des Albums"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Abbrechen</button>
                    <button type="submit" class="btn btn-primary" id="modalSubmitBtn">Erstellen</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openCreateModal() {
        document.getElementById('albumModalLabel').textContent = 'Neues Album';
        document.getElementById('modalId').value = '0';
        document.getElementById('modalName').value = '';
        document.getElementById('modalDescription').value = '';
        document.getElementById('modalSubmitBtn').textContent = 'Erstellen';
        document.getElementById('albumForm').setAttribute('action', '?handler=Create');
    }

    function openEditModal(id, name, description) {
        document.getElementById('albumModalLabel').textContent = 'Album bearbeiten';
        document.getElementById('modalId').value = id;
        document.getElementById('modalName').value = name;
        document.getElementById('modalDescription').value = description;
        document.getElementById('modalSubmitBtn').textContent = 'Speichern';
        document.getElementById('albumForm').setAttribute('action', '?handler=Edit');

        var modal = new bootstrap.Modal(document.getElementById('albumModal'));
        modal.show();
    }
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL"
        crossorigin="anonymous"></script>

@page "/admin"
@layout AdminLayout
@inject IImageRepository ImageRepository
@inject ITopicRepository TopicRepository
@inject IDuplicateLogRepository DuplicateLogRepository
@inject IProcessingQueue ProcessingQueue

<PageTitle>Projekt42 - Admin Dashboard</PageTitle>

<h1 class="mb-4">Dashboard</h1>

@if (loading)
{
    <p>Loading stats...</p>
}
else
{
    <div class="row g-3">
        <div class="col-md-3">
            <div class="admin-card text-center">
                <div class="stat-number">@totalImages</div>
                <div class="text-muted">Total Images</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="admin-card text-center">
                <div class="stat-number">@totalTopics</div>
                <div class="text-muted">Alben</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="admin-card text-center">
                <div class="stat-number">@totalDuplicates</div>
                <div class="text-muted">Duplicates</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="admin-card text-center">
                <div class="stat-number">@pendingQueue</div>
                <div class="text-muted">Pending in Queue</div>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <h5>Quick Links</h5>
        <div class="d-flex gap-2 flex-wrap">
            <a href="/admin/upload" class="btn btn-primary">Upload Images</a>
            <a href="/admin/alben" class="btn btn-outline-primary">Alben verwalten</a>
            <a href="/admin/duplicates" class="btn btn-outline-secondary">View Duplicates</a>
            <a href="/admin/settings" class="btn btn-outline-secondary">Settings</a>
        </div>
    </div>

    @if (recentImages.Any())
    {
        <div class="mt-4">
            <h5>Recently Added</h5>
            <div class="gallery-grid" style="grid-template-columns:repeat(auto-fill,minmax(150px,1fr));">
                @foreach (var image in recentImages)
                {
                    <div class="gallery-item">
                        @if (!string.IsNullOrEmpty(image.ThumbnailPath))
                        {
                            <img src="/images/thumbnail/@image.Id" alt="@image.OriginalFilename" loading="lazy" />
                        }
                        else
                        {
                            <div style="width:100%;height:150px;background:#e9ecef;display:flex;align-items:center;justify-content:center;">
                                <span style="font-size:0.75rem;color:#6c757d;">No preview</span>
                            </div>
                        }
                        <div class="gallery-item-info">
                            <small>@image.ProcessedAt.ToString("dd.MM.yy HH:mm")</small>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
}

@code {
    private int totalImages;
    private int totalTopics;
    private int totalDuplicates;
    private int pendingQueue;
    private List<Projekt42.Core.Models.Image> recentImages = new();
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        var images = (await ImageRepository.GetAllAsync()).ToList();
        totalImages = images.Count;
        recentImages = images.Take(10).ToList();

        totalTopics = (await TopicRepository.GetAllAsync()).Count();
        totalDuplicates = (await DuplicateLogRepository.GetAllAsync()).Count();
        pendingQueue = ProcessingQueue.Count;
        loading = false;
    }
}

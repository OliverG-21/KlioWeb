@page "/admin/login"
@model Projekt42.Web.Pages.Admin.LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Login - Projekt42</title>
    <link rel="stylesheet" href="~/css/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="d-flex align-items-center justify-content-center" style="min-height:100vh;background:#f8f9fa;">
    <div class="card shadow" style="width:380px;">
        <div class="card-body p-4">
            <h3 class="card-title text-center mb-4">Projekt42 Admin</h3>
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger">@Model.ErrorMessage</div>
            }
            <form method="post">
                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <input type="password" name="password" class="form-control" required autofocus />
                </div>
                <button type="submit" class="btn btn-primary w-100">Login</button>
                @Html.AntiForgeryToken()
            </form>
        </div>
    </div>
</body>
</html>

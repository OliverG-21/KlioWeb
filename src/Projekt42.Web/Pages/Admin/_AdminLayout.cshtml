@using Microsoft.AspNetCore.Mvc.RazorPages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Panel - Projekt42</title>
    <link rel="stylesheet" href="~/css/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        *, *::before, *::after { box-sizing: border-box; }
        body { margin: 0; padding: 0; min-height: 100vh; display: flex; flex-direction: column; }

        /* ── Wrapper ── */
        .admin-wrapper { display: flex; flex: 1; min-height: 100vh; }

        /* ── Sidebar ── */
        .admin-sidebar {
            width: 220px;
            height: 100vh;
            position: sticky;
            top: 0;
            background: #343a40;
            flex-shrink: 0;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
        }

        /* Brand */
        .sidebar-brand {
            padding: 1rem 1rem 1rem 0.9rem;
            color: #fff;
            font-weight: 700;
            font-size: 1.05rem;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 0.65rem;
        }

        /* Section labels */
        .nav-section {
            padding: 0.85rem 1rem 0.2rem;
            color: rgba(255,255,255,0.35);
            font-size: 0.68rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
        }

        /* Nav links */
        .admin-sidebar .nav-link {
            color: rgba(255,255,255,0.78);
            padding: 0.6rem 0.9rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            text-decoration: none;
            font-size: 0.92rem;
            transition: background 0.15s, color 0.15s;
        }
        .admin-sidebar .nav-link:hover { color: #fff; background: rgba(255,255,255,0.08); }
        .admin-sidebar .nav-link.active { color: #fff; background: rgba(255,255,255,0.15); }

        .nav-icon { flex-shrink: 0; width: 22px; text-align: center; font-size: 1.05rem; color: #fff; }

        /* Logout */
        .sidebar-logout { margin-top: auto; border-top: 1px solid rgba(255,255,255,0.1); padding: 0.4rem 0; }

        /* ── Content ── */
        .admin-content { flex: 1; display: flex; flex-direction: column; min-width: 0; }
        .admin-topbar {
            background: #fff;
            border-bottom: 1px solid #dee2e6;
            padding: 0.75rem 1.25rem;
            display: flex;
            align-items: center;
            font-weight: 600;
            color: #343a40;
        }
        .admin-main { flex: 1; padding: 1.5rem; }
    </style>
</head>
<body>
<div class="admin-wrapper">
    <aside class="admin-sidebar">

        <a href="/admin" class="sidebar-brand">
            <i class="bi bi-camera nav-icon"></i>
            <span class="nav-label">Projekt42</span>
        </a>

        <nav style="flex:1;">
            <span class="nav-section">Verwaltung</span>
            <a class="nav-link" href="/admin" title="Dashboard">
                <i class="bi bi-speedometer2 nav-icon"></i>
                <span class="nav-label">Dashboard</span>
            </a>
            <a class="nav-link" href="/admin/alben" title="Alben">
                <i class="bi bi-folder nav-icon"></i>
                <span class="nav-label">Alben</span>
            </a>
            <a class="nav-link" href="/admin/upload" title="Upload">
                <i class="bi bi-upload nav-icon"></i>
                <span class="nav-label">Upload</span>
            </a>
            <a class="nav-link" href="/admin/import" title="Ordner-Import">
                <i class="bi bi-folder-symlink nav-icon"></i>
                <span class="nav-label">Ordner-Import</span>
            </a>
            <a class="nav-link" href="/admin/unassigned" title="Nicht zugeordnet">
                <i class="bi bi-question-circle nav-icon"></i>
                <span class="nav-label">Nicht zugeordnet</span>
            </a>
            <a class="nav-link" href="/admin/duplicates" title="Duplikate">
                <i class="bi bi-files nav-icon"></i>
                <span class="nav-label">Duplikate</span>
            </a>
            <a class="nav-link" href="/admin/tagging" title="Tagging">
                <i class="bi bi-tags nav-icon"></i>
                <span class="nav-label">Tagging</span>
            </a>
            <span class="nav-section">System</span>
            <a class="nav-link" href="/admin/settings" title="Einstellungen">
                <i class="bi bi-gear nav-icon"></i>
                <span class="nav-label">Einstellungen</span>
            </a>
        </nav>

        <div class="sidebar-logout">
            <a class="nav-link" href="/admin/logout" title="Logout">
                <i class="bi bi-box-arrow-right nav-icon"></i>
                <span class="nav-label">Logout</span>
            </a>
        </div>
    </aside>

    <div class="admin-content">
        <div class="admin-topbar">Admin Panel</div>
        <main class="admin-main">
            @RenderBody()
        </main>
    </div>
</div>

<script src="~/js/bootstrap.bundle.min.js"></script>
@RenderSection("Scripts", required: false)
</body>
</html>

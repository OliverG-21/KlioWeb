@using Microsoft.AspNetCore.Mvc.RazorPages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Panel - Projekt42</title>
    <link rel="stylesheet" href="~/css/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        *, *::before, *::after { box-sizing: border-box; }

        body { margin: 0; padding: 0; min-height: 100vh; display: flex; flex-direction: column; }

        .admin-wrapper { display: flex; flex: 1; min-height: 100vh; }

        /* ── Sidebar ── */
        .admin-sidebar {
            width: 220px;
            min-height: 100vh;
            background: #343a40;
            flex-shrink: 0;
            display: flex;
            flex-direction: column;
            transition: width 0.25s ease;
            overflow: hidden;
            position: relative;
        }
        .admin-sidebar.collapsed { width: 52px; }

        /* Brand */
        .sidebar-brand {
            padding: 1.1rem 1rem;
            color: #fff;
            font-weight: 700;
            font-size: 1.05rem;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 0.6rem;
            white-space: nowrap;
            overflow: hidden;
        }
        .sidebar-brand .brand-icon { flex-shrink: 0; font-size: 1.1rem; }
        .sidebar-brand .brand-text { transition: opacity 0.15s; }
        .collapsed .sidebar-brand .brand-text { opacity: 0; pointer-events: none; }

        /* Toggle button */
        .sidebar-toggle {
            position: absolute;
            top: 0.75rem;
            right: 0.5rem;
            background: none;
            border: none;
            color: rgba(255,255,255,0.5);
            cursor: pointer;
            padding: 0.2rem 0.35rem;
            border-radius: 4px;
            font-size: 1rem;
            line-height: 1;
            transition: color 0.15s, background 0.15s;
            z-index: 10;
        }
        .sidebar-toggle:hover { color: #fff; background: rgba(255,255,255,0.1); }

        /* Section labels */
        .nav-section {
            padding: 0.9rem 1rem 0.2rem;
            color: rgba(255,255,255,0.35);
            font-size: 0.68rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            white-space: nowrap;
            overflow: hidden;
            transition: opacity 0.15s;
        }
        .collapsed .nav-section { opacity: 0; height: 0.5rem; padding: 0; }

        /* Nav links */
        .admin-sidebar .nav-link {
            color: rgba(255,255,255,0.75);
            padding: 0.6rem 0.9rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            text-decoration: none;
            font-size: 0.9rem;
            white-space: nowrap;
            transition: background 0.15s, color 0.15s;
            position: relative;
        }
        .admin-sidebar .nav-link:hover { color: #fff; background: rgba(255,255,255,0.08); }
        .admin-sidebar .nav-link.active { color: #fff; background: rgba(255,255,255,0.15); }

        .nav-link .nav-icon { flex-shrink: 0; width: 20px; text-align: center; font-size: 1rem; }
        .nav-link .nav-label { transition: opacity 0.15s; overflow: hidden; }
        .collapsed .nav-link .nav-label { opacity: 0; width: 0; }

        /* Logout at bottom */
        .sidebar-logout {
            margin-top: auto;
            border-top: 1px solid rgba(255,255,255,0.1);
            padding: 0.4rem 0;
        }

        /* ── Content ── */
        .admin-content { flex: 1; display: flex; flex-direction: column; min-width: 0; }

        .admin-topbar {
            background: #fff;
            border-bottom: 1px solid #dee2e6;
            padding: 0.75rem 1.25rem;
            display: flex;
            align-items: center;
            font-weight: 600;
            color: #343a40;
            gap: 0.75rem;
        }

        .admin-main { flex: 1; padding: 1.5rem; }
    </style>
</head>
<body>
<div class="admin-wrapper">
    <aside class="admin-sidebar" id="adminSidebar">

        <button class="sidebar-toggle" id="sidebarToggle" title="Navigation ein-/ausblenden">&#8942;</button>

        <a href="/admin" class="sidebar-brand">
            <span class="brand-icon">&#9881;</span>
            <span class="brand-text">Projekt42</span>
        </a>

        <nav class="mt-1" style="flex:1;">
            <span class="nav-section">Verwaltung</span>

            <a class="nav-link" href="/admin"
               title="Dashboard" data-bs-toggle="tooltip" data-bs-placement="right">
                <span class="nav-icon">&#128202;</span>
                <span class="nav-label">Dashboard</span>
            </a>
            <a class="nav-link" href="/admin/alben"
               title="Alben" data-bs-toggle="tooltip" data-bs-placement="right">
                <span class="nav-icon">&#128193;</span>
                <span class="nav-label">Alben</span>
            </a>
            <a class="nav-link" href="/admin/upload"
               title="Upload" data-bs-toggle="tooltip" data-bs-placement="right">
                <span class="nav-icon">&#11014;</span>
                <span class="nav-label">Upload</span>
            </a>
            <a class="nav-link" href="/admin/duplicates"
               title="Duplikate" data-bs-toggle="tooltip" data-bs-placement="right">
                <span class="nav-icon">&#128260;</span>
                <span class="nav-label">Duplikate</span>
            </a>

            <span class="nav-section">System</span>
            <a class="nav-link" href="/admin/settings"
               title="Einstellungen" data-bs-toggle="tooltip" data-bs-placement="right">
                <span class="nav-icon">&#128736;</span>
                <span class="nav-label">Einstellungen</span>
            </a>
        </nav>

        <div class="sidebar-logout">
            <a class="nav-link" href="/admin/logout"
               title="Logout" data-bs-toggle="tooltip" data-bs-placement="right">
                <span class="nav-icon">&#128682;</span>
                <span class="nav-label">Logout</span>
            </a>
        </div>
    </aside>

    <div class="admin-content">
        <div class="admin-topbar">
            <span style="color:#6c757d;font-size:0.85rem;">Admin Panel</span>
        </div>
        <main class="admin-main">
            @RenderBody()
        </main>
    </div>
</div>

<script src="~/js/bootstrap.bundle.min.js"></script>
<script>
    (function () {
        const sidebar = document.getElementById('adminSidebar');
        const toggle  = document.getElementById('sidebarToggle');
        const STORE   = 'adminSidebarCollapsed';
        let tooltips  = [];

        function applyState(collapsed, animate) {
            if (!animate) sidebar.style.transition = 'none';
            sidebar.classList.toggle('collapsed', collapsed);
            if (!animate) requestAnimationFrame(() => sidebar.style.transition = '');

            // Tooltips: only active when collapsed
            tooltips.forEach(t => t.dispose());
            tooltips = [];
            if (collapsed) {
                sidebar.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(el => {
                    tooltips.push(new bootstrap.Tooltip(el, { trigger: 'hover' }));
                });
            }

            toggle.innerHTML = collapsed ? '&#8250;' : '&#8942;';
            toggle.title     = collapsed ? 'Navigation aufklappen' : 'Navigation einklappen';
        }

        // Restore saved state immediately (no animation to prevent flash)
        const saved = localStorage.getItem(STORE) === 'true';
        applyState(saved, false);

        toggle.addEventListener('click', () => {
            const next = !sidebar.classList.contains('collapsed');
            localStorage.setItem(STORE, next);
            applyState(next, true);
        });
    })();
</script>
</body>
</html>

@page "/admin/alben"
@page "/admin/topics"
@layout AdminLayout
@inject ITopicRepository TopicRepository
@inject IImageRepository ImageRepository

<PageTitle>Projekt42 - Alben</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Alben</h1>
    <button class="btn btn-primary" @onclick="ShowAddForm">+ Neues Album</button>
</div>

@if (showForm)
{
    <div class="modal show d-block" style="background:rgba(0,0,0,0.5);" @onclick="CancelEdit">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(editingTopic == null ? "Neues Album" : "Album bearbeiten")</h5>
                    <button type="button" class="btn-close" @onclick="CancelEdit"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input type="text" class="form-control" @bind="formName" placeholder="z.B. Urlaub Italien 2024" autofocus />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Beschreibung <span class="text-muted">(optional)</span></label>
                        <textarea class="form-control" @bind="formDescription" rows="3" placeholder="Kurze Beschreibung des Albums"></textarea>
                    </div>
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger">@errorMessage</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CancelEdit">Abbrechen</button>
                    <button class="btn btn-primary" @onclick="SaveTopic">
                        @(editingTopic == null ? "Erstellen" : "Speichern")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (loading)
{
    <p>Alben werden geladen...</p>
}
else if (!topics.Any())
{
    <div class="text-center py-5 text-muted">
        <div style="font-size:3rem;">📁</div>
        <p class="mt-2">Noch keine Alben vorhanden.</p>
        <button class="btn btn-primary" @onclick="ShowAddForm">Erstes Album erstellen</button>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var topic in topics)
        {
            var count = imageCounts.GetValueOrDefault(topic.Id, 0);
            var coverId = coverImageIds.GetValueOrDefault(topic.Id, 0);
            <div class="col-sm-6 col-md-4 col-lg-3">
                <div class="card h-100 shadow-sm">
                    <a href="/topic/@topic.Id" style="text-decoration:none;color:inherit;">
                        @if (coverId > 0)
                        {
                            <img src="/images/thumbnail/@coverId" class="card-img-top" alt="@topic.Name"
                                 style="height:160px;object-fit:cover;" />
                        }
                        else
                        {
                            <div class="card-img-top d-flex align-items-center justify-content-center bg-light"
                                 style="height:160px;font-size:2.5rem;">
                                📷
                            </div>
                        }
                    </a>
                    <div class="card-body pb-1">
                        <h6 class="card-title mb-1">
                            <a href="/topic/@topic.Id" style="text-decoration:none;color:inherit;">@topic.Name</a>
                        </h6>
                        @if (!string.IsNullOrEmpty(topic.Description))
                        {
                            <p class="card-text text-muted" style="font-size:0.8rem;">
                                @(topic.Description.Length > 80 ? topic.Description[..80] + "…" : topic.Description)
                            </p>
                        }
                    </div>
                    <div class="card-footer d-flex justify-content-between align-items-center bg-transparent border-top-0 pt-0">
                        <small class="text-muted">@count Foto@(count != 1 ? "s" : "")</small>
                        <div>
                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditTopic(topic)">✏️</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteTopic(topic.Id)"
                                    disabled="@(count > 0)">🗑️</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<Topic> topics = new();
    private Dictionary<int, int> imageCounts = new();
    private Dictionary<int, int> coverImageIds = new();
    private Topic? editingTopic;
    private string formName = string.Empty;
    private string formDescription = string.Empty;
    private string errorMessage = string.Empty;
    private bool showForm;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        loading = false;
    }

    private async Task LoadData()
    {
        topics = (await TopicRepository.GetAllAsync()).ToList();
        var allImages = (await ImageRepository.GetAllAsync()).ToList();

        imageCounts = allImages
            .Where(i => i.TopicId.HasValue)
            .GroupBy(i => i.TopicId!.Value)
            .ToDictionary(g => g.Key, g => g.Count());

        coverImageIds = allImages
            .Where(i => i.TopicId.HasValue)
            .GroupBy(i => i.TopicId!.Value)
            .ToDictionary(g => g.Key, g => g.OrderBy(i => i.DateTaken).First().Id);
    }

    private void ShowAddForm()
    {
        editingTopic = null;
        formName = string.Empty;
        formDescription = string.Empty;
        errorMessage = string.Empty;
        showForm = true;
    }

    private void EditTopic(Topic topic)
    {
        editingTopic = topic;
        formName = topic.Name;
        formDescription = topic.Description ?? string.Empty;
        errorMessage = string.Empty;
        showForm = true;
    }

    private void CancelEdit()
    {
        showForm = false;
        editingTopic = null;
        formName = string.Empty;
        formDescription = string.Empty;
        errorMessage = string.Empty;
    }

    private async Task SaveTopic()
    {
        if (string.IsNullOrWhiteSpace(formName))
        {
            errorMessage = "Name ist erforderlich.";
            return;
        }

        errorMessage = string.Empty;

        if (editingTopic == null)
        {
            await TopicRepository.AddAsync(new Topic
            {
                Name = formName.Trim(),
                Description = formDescription.Trim()
            });
        }
        else
        {
            editingTopic.Name = formName.Trim();
            editingTopic.Description = formDescription.Trim();
            await TopicRepository.UpdateAsync(editingTopic);
        }

        CancelEdit();
        await LoadData();
    }

    private async Task DeleteTopic(int id)
    {
        await TopicRepository.DeleteAsync(id);
        await LoadData();
    }
}

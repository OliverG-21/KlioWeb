@page "/admin/upload"
@layout AdminLayout
@inject IFileOrganizerService FileOrganizerService
@inject IAppSettingsRepository AppSettingsRepository
@inject ILogger<AdminUpload> Logger

<PageTitle>Projekt42 - Upload</PageTitle>

<h1 class="mb-4">Upload Images</h1>

<div class="admin-card">
    <p class="text-muted">
        Select one or more images (JPEG, PNG, HEIC) to upload. Files will be processed through the standard pipeline:
        hash deduplication, EXIF extraction, thumbnail generation, and organized storage.
    </p>

    <InputFile OnChange="HandleFileSelection" multiple accept=".jpg,.jpeg,.png,.heic,.heif" class="form-control mb-3" />

    @if (selectedFiles.Any())
    {
        <div class="mb-3">
            <strong>@selectedFiles.Count file(s) selected</strong>
        </div>
        <button class="btn btn-primary" @onclick="UploadFiles" disabled="@uploading">
            @if (uploading)
            {
                <span>Uploading...</span>
            }
            else
            {
                <span>Upload</span>
            }
        </button>
    }
</div>

@if (results.Any())
{
    <div class="mt-4">
        <h5>Upload Results</h5>
        <ul class="list-group">
            @foreach (var result in results)
            {
                <li class="list-group-item d-flex align-items-center gap-2">
                    <span class="@(result.Success ? "text-success" : "text-danger")">
                        @(result.Success ? "✓" : "✗")
                    </span>
                    <div>
                        <strong>@result.FileName</strong>
                        @if (!string.IsNullOrEmpty(result.Message))
                        {
                            <br /><small class="text-muted">@result.Message</small>
                        }
                    </div>
                </li>
            }
        </ul>
    </div>
}

@code {
    private List<IBrowserFile> selectedFiles = new();
    private bool uploading;
    private List<UploadResult> results = new();

    private void HandleFileSelection(InputFileChangeEventArgs e)
    {
        selectedFiles = e.GetMultipleFiles(50).ToList();
        results.Clear();
    }

    private async Task UploadFiles()
    {
        if (!selectedFiles.Any() || uploading) return;

        uploading = true;
        results.Clear();

        var settings = await AppSettingsRepository.GetAsync();
        var inboxPath = settings.InboxPath;
        Directory.CreateDirectory(inboxPath);

        foreach (var file in selectedFiles)
        {
            try
            {
                // Save to inbox
                var safeFileName = Path.GetFileName(file.Name);
                var destPath = Path.Combine(inboxPath, safeFileName);

                // If file with same name exists, add guid to avoid collision
                if (File.Exists(destPath))
                {
                    destPath = Path.Combine(inboxPath,
                        $"{Path.GetFileNameWithoutExtension(safeFileName)}_{Guid.NewGuid():N}{Path.GetExtension(safeFileName)}");
                }

                await using var destStream = File.Create(destPath);
                await using var sourceStream = file.OpenReadStream(maxAllowedSize: 100 * 1024 * 1024); // 100MB max
                await sourceStream.CopyToAsync(destStream);
                destStream.Close();

                // Process immediately via FileOrganizerService
                var image = await FileOrganizerService.OrganizeAsync(destPath);
                results.Add(new UploadResult(file.Name, true, $"Stored as {image.StoredFilename}"));
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Upload failed for {FileName}", file.Name);
                results.Add(new UploadResult(file.Name, false, ex.Message));
            }
        }

        selectedFiles.Clear();
        uploading = false;
    }

    private record UploadResult(string FileName, bool Success, string Message);
}

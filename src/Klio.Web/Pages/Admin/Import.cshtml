@page "/admin/import"
@model Klio.Web.Pages.Admin.ImportModel
@{
    Layout = "_AdminLayout";
}

<h1 class="mb-4">Ordner-Import</h1>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.LastResult != null)
{
    var r = Model.LastResult;
    var hasErrors = r.Errors.Count > 0;
    <div class="alert @(hasErrors ? "alert-warning" : "alert-success") alert-dismissible fade show" role="alert">
        <strong>Import abgeschlossen:</strong>
        @r.FoldersCreated Ordner angelegt &middot;
        @r.AlbumsCreated Alben angelegt &middot;
        @r.AlbumsReused Alben wiederverwendet &middot;
        @r.FilesEnqueued Dateien in Queue eingereiht
        @if (hasErrors)
        {
            <ul class="mb-0 mt-2 small">
                @foreach (var err in r.Errors)
                {
                    <li>@err</li>
                }
            </ul>
        }
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <h5 class="mb-0"><i class="bi bi-folder2-open me-2"></i>FolderInbox</h5>
                    <span class="badge bg-secondary">@Model.InboxEntries.Count Einträge</span>
                </div>
                <form method="post" asp-page-handler="SavePath" asp-antiforgery="true" class="d-flex gap-2">
                    <input type="text" name="folderInboxPath" class="form-control form-control-sm"
                           value="@Model.FolderInboxPath" placeholder="/storage/folder_inbox" />
                    <button type="submit" class="btn btn-sm btn-outline-light text-nowrap">
                        <i class="bi bi-check2"></i> Speichern
                    </button>
                </form>
            </div>
            <div class="card-body">
                @if (Model.InboxEntries.Count == 0)
                {
                    <p class="text-muted mb-0">
                        <i class="bi bi-inbox me-1"></i>
                        FolderInbox ist leer. Lege Ordner, ZIP-Dateien oder Bilder ab und starte dann den Import.
                    </p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var entry in Model.InboxEntries.OrderBy(e => e.Type).ThenBy(e => e.Name))
                        {
                            <li class="list-group-item d-flex align-items-center gap-2 px-0">
                                @if (entry.Type == FolderInboxEntryType.Directory)
                                {
                                    <i class="bi bi-folder-fill text-warning"></i>
                                    <span>@entry.Name</span>
                                    @if (entry.FileCount.HasValue)
                                    {
                                        <span class="badge bg-light text-secondary ms-auto">@entry.FileCount Dateien</span>
                                    }
                                }
                                else if (entry.Type == FolderInboxEntryType.Zip)
                                {
                                    <i class="bi bi-file-zip-fill text-primary"></i>
                                    <span>@entry.Name</span>
                                    <span class="badge bg-light text-secondary ms-auto">ZIP</span>
                                }
                                else
                                {
                                    <i class="bi bi-file-image text-secondary"></i>
                                    <span>@entry.Name</span>
                                }
                            </li>
                        }
                    </ul>
                }
            </div>
            <div class="card-footer d-flex gap-2">
                <form method="post" asp-page-handler="StartImport" asp-antiforgery="true">
                    <button type="submit" class="btn btn-primary" @(Model.InboxEntries.Count == 0 ? "disabled" : "")>
                        <i class="bi bi-play-fill me-1"></i>Import starten
                    </button>
                </form>
                @if (Model.InboxEntries.Count > 0)
                {
                    <form method="post" asp-page-handler="ClearInbox" asp-antiforgery="true"
                          onsubmit="return confirm('FolderInbox wirklich leeren? Alle Dateien und Ordner darin werden gelöscht.')">
                        <button type="submit" class="btn btn-outline-danger">
                            <i class="bi bi-trash3 me-1"></i>FolderInbox leeren
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm border-info">
            <div class="card-header bg-info bg-opacity-10">
                <h6 class="mb-0"><i class="bi bi-info-circle me-1"></i>Wie funktioniert es?</h6>
            </div>
            <div class="card-body small text-muted">
                <p>Lege Ordner, ZIP-Dateien oder einzelne Bilder in den <strong>FolderInbox</strong>-Pfad.</p>
                <p>Beim Import wird die Ordnerstruktur in Alben und Ordner übersetzt:</p>
                <ul>
                    <li>Jedes Verzeichnis → <strong>AlbumOrdner</strong></li>
                    <li>Verzeichnis mit Dateien → zusätzlich <strong>Album</strong> gleichen Namens</li>
                    <li>Bereits existierende Ordner/Alben werden wiederverwendet</li>
                    <li>Dateien direkt im Inbox-Root → kein Album</li>
                    <li>ZIP-Dateien werden entpackt und wie Ordner behandelt</li>
                </ul>
                <p class="mb-0"><strong>Unterstützte Formate:</strong> JPG, PNG, HEIC/HEIF, MP4, WebM</p>
            </div>
        </div>
    </div>
</div>

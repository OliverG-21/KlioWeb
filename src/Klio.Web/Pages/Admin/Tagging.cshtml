@page "/admin/tagging"
@model Klio.Web.Pages.Admin.TaggingModel
@{
    Layout = "_AdminLayout";
    var totalPages = (int)Math.Ceiling((double)Model.TotalImages / Klio.Web.Pages.Admin.TaggingModel.PageSize);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Tagging</h1>
    <span class="text-muted" style="font-size:0.9rem;">@Model.TotalImages Bilder gesamt</span>
</div>

<!-- Tag Management -->
<div class="card shadow-sm mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-tags me-2"></i>Tag-Verwaltung</h5>
        <button class="btn btn-sm btn-outline-secondary" onclick="loadAllTags()">
            <i class="bi bi-arrow-clockwise"></i> Aktualisieren
        </button>
    </div>
    <div class="card-body">
        <!-- Tag list -->
        <div id="tag-management-list" class="d-flex flex-wrap gap-2 mb-3" style="min-height:2rem;">
            <span class="text-muted" style="font-size:0.85rem;">Wird geladen…</span>
        </div>
        <!-- Merge -->
        <div class="border-top pt-3">
            <label class="form-label fw-semibold mb-2">Tags zusammenführen</label>
            <div class="d-flex gap-2 align-items-center flex-wrap">
                <input id="merge-source" type="text" class="form-control form-control-sm" style="width:180px;"
                       placeholder="Quell-Tag (wird entfernt)" list="merge-source-list" autocomplete="off" />
                <datalist id="merge-source-list"></datalist>
                <i class="bi bi-arrow-right text-muted"></i>
                <input id="merge-target" type="text" class="form-control form-control-sm" style="width:180px;"
                       placeholder="Ziel-Tag (bleibt erhalten)" list="merge-target-list" autocomplete="off" />
                <datalist id="merge-target-list"></datalist>
                <button class="btn btn-sm btn-warning" onclick="mergeTags()">
                    <i class="bi bi-intersect me-1"></i> Zusammenführen
                </button>
            </div>
        </div>
    </div>
</div>

@if (!Model.Images.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-images" style="font-size:3rem;display:block;margin-bottom:1rem;"></i>
        <p>Keine Bilder vorhanden.</p>
    </div>
}
else
{
    <!-- Image grid -->
    <div class="row g-2" id="tag-grid">
        @foreach (var image in Model.Images)
        {
            <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                <div class="tag-thumb-card" data-id="@image.Id" data-name="@image.OriginalFilename"
                     onclick="openTagEditor(@image.Id, '@Html.Raw(image.OriginalFilename.Replace("'", "\\'"))')">
                    @if (!string.IsNullOrEmpty(image.ThumbnailPath))
                    {
                        <img src="/images/thumbnail/@image.Id" alt="@image.OriginalFilename" loading="lazy" />
                    }
                    else
                    {
                        <div class="tag-thumb-placeholder"><i class="bi bi-image text-muted"></i></div>
                    }
                    <div class="tag-thumb-badge" id="badge-@image.Id" style="display:none;">
                        <span class="badge bg-primary rounded-pill" id="badge-count-@image.Id"></span>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                @for (int p = 1; p <= totalPages; p++)
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")">
                        <a class="page-link" href="/admin/tagging?page=@p">@p</a>
                    </li>
                }
            </ul>
        </nav>
    }
}

<!-- Tag Editor Modal -->
<div class="modal fade" id="tagModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Tags bearbeiten</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <!-- Thumbnail preview -->
                <div class="text-center mb-3">
                    <img id="modal-thumb" src="" alt="" style="max-height:160px;max-width:100%;object-fit:contain;border-radius:4px;" />
                    <div class="text-muted mt-1" style="font-size:0.8rem;" id="modal-filename"></div>
                </div>

                <!-- Current tags -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">Aktuelle Tags</label>
                    <div id="current-tags" class="d-flex flex-wrap gap-1 min-height-tags">
                        <span class="text-muted" style="font-size:0.85rem;" id="no-tags-hint">Keine Tags vorhanden.</span>
                    </div>
                </div>

                <!-- Available tags – click to add directly -->
                <div class="mb-3">
                    <label class="form-label fw-semibold mb-1">
                        Verfügbare Tags
                        <small class="text-muted fw-normal">— klicken zum Hinzufügen</small>
                    </label>
                    <input type="text" id="tag-filter" class="form-control form-control-sm mb-2"
                           placeholder="Filtern…" autocomplete="off" />
                    <div id="suggestion-chips" class="d-flex flex-wrap gap-1"
                         style="max-height:180px;overflow-y:auto;"></div>
                </div>

                <!-- Create new tag -->
                <div class="border-top pt-3">
                    <label class="form-label fw-semibold">Neuen Tag erstellen</label>
                    <div class="input-group">
                        <input type="text" id="tag-input" class="form-control" placeholder="Neuer Tag…"
                               autocomplete="off"
                               onkeydown="if(event.key==='Enter'){event.preventDefault();addTag();}" />
                        <button class="btn btn-primary" type="button" onclick="addTag()">
                            <i class="bi bi-plus-lg"></i> Hinzufügen
                        </button>
                    </div>
                    <div id="tag-error" class="text-danger mt-1" style="font-size:0.82rem;display:none;"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Schließen</button>
            </div>
        </div>
    </div>
</div>

<style>
.tag-thumb-card {
    position: relative;
    cursor: pointer;
    border-radius: 4px;
    overflow: hidden;
    border: 2px solid transparent;
    transition: border-color 0.15s;
    aspect-ratio: 1;
    background: #e9ecef;
}
.tag-thumb-card:hover { border-color: #1b6ec2; }
.tag-thumb-card img {
    width: 100%; height: 100%; object-fit: cover; display: block;
}
.tag-thumb-placeholder {
    width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 2rem;
}
.tag-thumb-badge {
    position: absolute; top: 4px; right: 4px;
}
.min-height-tags { min-height: 2rem; }
</style>

<script>
(function () {
    var modal        = null;
    var activeId     = null;
    var allTags      = [];   // all distinct tags in system
    var currentTags  = [];   // tags already on the active image

    // Load all existing tag suggestions once
    fetch('?handler=Suggestions')
        .then(r => r.json())
        .then(function (tags) {
            allTags = tags;
            renderSuggestionChips('');
        });

    // Load tag counts for visible images
    document.querySelectorAll('.tag-thumb-card').forEach(function (card) {
        var id = card.dataset.id;
        fetch('?handler=ImageTags&imageId=' + id)
            .then(r => r.json())
            .then(function (tags) {
                if (tags.length > 0) {
                    document.getElementById('badge-' + id).style.display = 'block';
                    document.getElementById('badge-count-' + id).textContent = tags.length;
                }
            });
    });

    window.openTagEditor = function (imageId, filename) {
        activeId = imageId;
        currentTags = [];
        document.getElementById('modal-thumb').src = '/images/thumbnail/' + imageId;
        document.getElementById('modal-filename').textContent = filename;
        document.getElementById('tag-input').value = '';
        document.getElementById('tag-filter').value = '';
        document.getElementById('tag-error').style.display = 'none';
        renderSuggestionChips('');
        loadCurrentTags();

        if (!modal) modal = new bootstrap.Modal(document.getElementById('tagModal'));
        modal.show();
    };

    function loadCurrentTags() {
        fetch('?handler=ImageTags&imageId=' + activeId)
            .then(r => r.json())
            .then(renderCurrentTags);
    }

    function renderCurrentTags(tags) {
        currentTags = tags.map(t => t.tag);
        var container = document.getElementById('current-tags');
        var hint      = document.getElementById('no-tags-hint');

        // Remove all existing tag badges (including any pending) but keep the hint in the DOM.
        Array.from(container.children).forEach(function (el) {
            if (el !== hint) el.remove();
        });

        if (tags.length === 0) {
            hint.style.display = '';
        } else {
            hint.style.display = 'none';
            tags.forEach(function (t) {
                var span = document.createElement('span');
                span.className = 'badge bg-secondary d-inline-flex align-items-center gap-1';
                span.style.cssText = 'font-size:0.85rem;padding:0.35em 0.6em;';
                span.innerHTML = escHtml(t.tag)
                    + (t.source === 0
                        ? ' <span style="font-size:0.7em;opacity:0.7;">(auto)</span>'
                        : '')
                    + ' <button type="button" onclick="removeTag(' + t.id + ')" '
                    + 'style="background:none;border:none;color:inherit;padding:0;line-height:1;cursor:pointer;font-size:1em;" '
                    + 'title="Tag entfernen">&times;</button>';
                container.appendChild(span);
            });
        }
        updateCardBadge();
        renderSuggestionChips(document.getElementById('tag-input').value);
    }

    function renderSuggestionChips(filter) {
        var container = document.getElementById('suggestion-chips');
        var lfilter   = (filter || '').toLowerCase();
        var chips = allTags.filter(function (t) {
            return (!lfilter || t.includes(lfilter)) && !currentTags.includes(t);
        });
        if (chips.length === 0) {
            container.innerHTML = '<span class="text-muted" style="font-size:0.8rem;">'
                + (lfilter ? 'Kein passender Tag.' : 'Alle vorhandenen Tags sind bereits zugewiesen.')
                + '</span>';
            return;
        }
        container.innerHTML = chips.map(function (t) {
            return '<button type="button" class="btn btn-sm btn-outline-primary" '
                + 'style="font-size:0.8rem;padding:0.2rem 0.55rem;" '
                + 'onclick="selectSuggestion(\'' + escAttr(t) + '\')">'
                + '<i class="bi bi-plus-lg" style="font-size:0.75rem;"></i> ' + escHtml(t)
                + '</button>';
        }).join('');
    }

    window.selectSuggestion = function (tag) {
        // Direct add on chip click — no indirection through the new-tag input.
        addTagToImage(tag);
    };

    window.addTag = function () {
        var input = document.getElementById('tag-input');
        var tag   = input.value.trim().toLowerCase();
        if (!tag) return;
        input.value = '';
        addTagToImage(tag);
    };

    function addTagToImage(tag) {
        var errEl = document.getElementById('tag-error');
        errEl.style.display = 'none';

        if (currentTags.includes(tag)) {
            // Already applied — reload in case the UI was out of sync with the server.
            loadCurrentTags();
            return;
        }

        // Optimistic UI update so the tag appears instantly in the current-tags list.
        currentTags.push(tag);
        addPendingBadge(tag);
        renderSuggestionChips(document.getElementById('tag-filter').value);

        var token = document.querySelector('input[name="__RequestVerificationToken"]');
        fetch('?handler=AddTag', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token ? token.value : ''
            },
            body: JSON.stringify({ imageId: activeId, tag: tag })
        }).then(function (r) {
            if (r.status === 409) {
                // Server already knows this tag for the image (e.g. auto-tagged in
                // background). Drop the optimistic badge and reload so the real tag
                // becomes visible.
                revertPending(tag);
                loadCurrentTags();
                return null;
            }
            if (!r.ok) {
                revertPending(tag);
                errEl.textContent = 'Fehler beim Hinzufügen.';
                errEl.style.display = '';
                return null;
            }
            return r.json();
        }).then(function (data) {
            if (!data) return;
            if (!allTags.includes(data.tag)) {
                allTags.push(data.tag);
                allTags.sort();
            }
            // Swap pending badge with real one (provides id for removeTag).
            loadCurrentTags();
        });
    }

    function addPendingBadge(tag) {
        document.getElementById('no-tags-hint').style.display = 'none';
        var container = document.getElementById('current-tags');
        var span = document.createElement('span');
        span.className = 'badge bg-secondary d-inline-flex align-items-center gap-1';
        span.style.cssText = 'font-size:0.85rem;padding:0.35em 0.6em;opacity:0.65;';
        span.dataset.pending = tag;
        span.textContent = tag;
        container.appendChild(span);
        updateCardBadge();
    }

    function revertPending(tag) {
        var idx = currentTags.indexOf(tag);
        if (idx >= 0) currentTags.splice(idx, 1);
        document.querySelectorAll('#current-tags [data-pending]').forEach(function (el) {
            if (el.dataset.pending === tag) el.remove();
        });
        if (currentTags.length === 0) {
            var hint = document.getElementById('no-tags-hint');
            if (hint) hint.style.display = '';
        }
        updateCardBadge();
        renderSuggestionChips(document.getElementById('tag-filter').value);
    }

    function updateCardBadge() {
        var badge = document.getElementById('badge-' + activeId);
        var count = document.getElementById('badge-count-' + activeId);
        if (!badge || !count) return;
        if (currentTags.length > 0) {
            badge.style.display = 'block';
            count.textContent = currentTags.length;
        } else {
            badge.style.display = 'none';
        }
    }

    window.removeTag = function (tagId) {
        var token = document.querySelector('input[name="__RequestVerificationToken"]');
        fetch('?handler=RemoveTag&tagId=' + tagId, {
            method: 'POST',
            headers: { 'RequestVerificationToken': token ? token.value : '' }
        }).then(function (r) {
            if (r.ok) loadCurrentTags();
        });
    };

    document.getElementById('tag-filter').addEventListener('input', function () {
        renderSuggestionChips(this.value);
    });

    function escHtml(s) {
        return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }
    function escAttr(s) {
        return String(s).replace(/'/g,"\\'");
    }
})();
</script>

@section Scripts {
@Html.AntiForgeryToken()
}

<script>
(function () {
    var _allTags = [];
    var _af = '';

    function getAf() {
        if (!_af) _af = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        return _af;
    }

    function loadAllTags() {
        fetch('?handler=AllTags')
            .then(function(r) { return r.json(); })
            .then(function(tags) {
                _allTags = tags.map(function(t) { return t.tag; });
                var list = document.getElementById('tag-management-list');
                list.innerHTML = '';

                // Fill datalists
                ['merge-source-list','merge-target-list'].forEach(function(id) {
                    var dl = document.getElementById(id);
                    dl.innerHTML = _allTags.map(function(t) {
                        return '<option value="' + esc(t) + '">';
                    }).join('');
                });

                if (tags.length === 0) {
                    list.innerHTML = '<span class="text-muted" style="font-size:0.85rem;">Keine Tags vorhanden.</span>';
                    return;
                }
                tags.forEach(function(t) {
                    var badge = document.createElement('span');
                    badge.style.cssText = 'display:inline-flex;align-items:center;gap:0.3rem;background:#e9ecef;border-radius:20px;padding:0.2rem 0.6rem;font-size:0.82rem;';
                    badge.innerHTML = '<span>' + esc(t.tag) + '</span>' +
                        '<small class="text-muted">(' + t.count + ')</small>' +
                        '<button title="Tag löschen" onclick="deleteTag(\'' + escAttr(t.tag) + '\')" ' +
                        'style="background:none;border:none;color:#dc3545;cursor:pointer;padding:0;font-size:0.8rem;line-height:1;">' +
                        '<i class="bi bi-x-lg"></i></button>';
                    list.appendChild(badge);
                });
            });
    }

    window.loadAllTags = loadAllTags;

    window.deleteTag = function(tag) {
        if (!confirm('Tag "' + tag + '" von allen Bildern entfernen?')) return;
        fetch('?handler=DeleteTag', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getAf() },
            body: JSON.stringify({ tag: tag })
        }).then(function() { loadAllTags(); });
    };

    window.mergeTags = function() {
        var src = document.getElementById('merge-source').value.trim().toLowerCase();
        var tgt = document.getElementById('merge-target').value.trim().toLowerCase();
        if (!src || !tgt) { alert('Bitte beide Tags eingeben.'); return; }
        if (src === tgt) { alert('Quell- und Ziel-Tag sind identisch.'); return; }
        if (!confirm('Tag "' + src + '" in "' + tgt + '" zusammenführen?\n"' + src + '" wird von allen Bildern entfernt.')) return;
        fetch('?handler=MergeTags', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getAf() },
            body: JSON.stringify({ sourceTag: src, targetTag: tgt })
        }).then(function() {
            document.getElementById('merge-source').value = '';
            document.getElementById('merge-target').value = '';
            loadAllTags();
        });
    };

    function esc(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
    function escAttr(s) { return String(s).replace(/'/g,"\\'"); }

    loadAllTags();
})();
</script>
